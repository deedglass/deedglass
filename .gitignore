# build output
/bin/
/deedglass
*.test
*.out
coverage.*
# local throwaway clusters and logs (scripts/integration_local.sh)
/.tmp/
# editor / OS
.DS_Store
.idea/
.vscode/
# never commit keys or secrets (.deedglass/ holds dev secrets and local keys; mode 0700)
.deedglass/
*.key
*.pem
# except the published RFC 8032 test-vector keys the S09 intent vectors are signed with
!testdata/intents/keys/*.pem
.env
.env.*
!.env.example
# the browser verifier's dev tools and build output (web/verify)
web/verify/node_modules/
web/verify/dist/
# the Acme demo stack's local state (make demo-up): agent keys, the seal key, logs
examples/demo/.demo-keys
examples/demo/.demo-keys.tmp
examples/demo/.demo/
# S30: deedglass dev stripe-fixtures writes the sandbox ids here (mode 0600)
examples/demo/.stripe-fixtures.json
# the Console (web/ → make web-build): the build is embedded from internal/console/dist; only .keep is committed
internal/console/dist/*
!internal/console/dist/.keep
web/node_modules/
web/.astro/
web/test-results/
web/playwright-report/
web/e2e/.auth/

# S31: the TypeScript SDK
sdk/typescript/node_modules/
sdk/typescript/dist/
sdk/typescript/coverage/
examples/ts/node_modules/

# S32: the Python SDK and deedglass scan's outputs
sdk/python/.venv/
sdk/python/dist/
sdk/python/.pytest_cache/
sdk/python/.mypy_cache/
sdk/python/.ruff_cache/
sdk/python/.coverage
sdk/python/htmlcov/
__pycache__/
/deedglass-scan.md
/deedglass-scan.html
/deedglass-scan.json
/deedglass-scan.sarif
npm/node_modules/
npm/*.tgz
npm/cli-*/deedglass
npm/cli-*/deedglass.exe
