{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.deedglass/deedglass",
  "title": "Deedglass",
  "description": "Deedglass lets rules decide each AI agent tool call, checks what really changed and seals a record.",
  "version": "0.10.0",
  "websiteUrl": "https://deedglass.com",
  "repository": { "url": "https://github.com/deedglass/deedglass", "source": "github" },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "deedglass",
      "version": "0.10.0",
      "transport": { "type": "stdio" },
      "packageArguments": [
        { "type": "positional", "value": "mcp" },
        { "type": "positional", "value": "serve" }
      ],
      "environmentVariables": [
        { "name": "DEEDGLASS_SERVER", "description": "Your Deedglass server", "default": "http://127.0.0.1:8080", "isRequired": false },
        { "name": "DEEDGLASS_API_KEY", "description": "An agent key from deedglass init", "isSecret": true, "isRequired": false }
      ]
    }
  ]
}
