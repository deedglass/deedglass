    {
      "starter": "postgres-safe",
      "rule": "block-destructive-sql",
      "why": "DROP and TRUNCATE never run, whatever the agent sends.",
      "yaml": "deedglass: policy/v1\nname: scan-block-destructive-sql\ndescription: Suggested by deedglass scan from the postgres-safe starter.\n\ndefaults:\n  decision: deny\n  reason: No rule allows this action. Add a rule in Console › Policies to allow it.\n\nrules:\n  - id: block-destructive-sql\n    match: { connector_type: postgres }\n    when: sql.kind in [\"drop\", \"truncate\"]\n    decision: deny\n    reason: DROP and TRUNCATE are never allowed for agents.\n    notify: [slack]\n"
    },
    {
      "starter": "postgres-safe",
      "rule": "writes-need-approval",
      "why": "Writes to public.orders wait for a person.",
      "yaml": "deedglass: policy/v1\nname: scan-writes-need-approval\ndescription: Suggested by deedglass scan from the postgres-safe starter.\n\ndefaults:\n  decision: deny\n  reason: No rule allows this action. Add a rule in Console › Policies to allow it.\n\nrules:\n  - id: writes-need-approval\n    match: { tool: postgres.execute }\n    when: sql.category == \"write\" && \"public.orders\" in sql.tables\n    decision: require_approval\n    reason: Writes to this database wait for a human. An admin can approve in Console › Approvals.\n    approval: { approvers: [role:admin], required: 1, expires_in: 30m }\n    notify: [email, slack]\n    verify: L2\n"
    },
