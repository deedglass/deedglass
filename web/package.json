{
  "name": "@deedglass/console",
  "version": "0.15.1",
  "private": true,
  "description": "The Deedglass Console: a static Astro build embedded in the deedglass binary.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "tokens": "node scripts/gen-tokens.mjs",
    "tokens:check": "node scripts/gen-tokens.mjs --check",
    "contrast": "node scripts/contrast.mjs",
    "icons": "node scripts/icons.mjs && node scripts/brandmarks.mjs",
    "build": "node scripts/gen-tokens.mjs && node scripts/icons.mjs && node scripts/brandmarks.mjs && astro build && node scripts/compress.mjs && node scripts/check-dist.mjs",
    "dev": "astro dev --port 4321",
    "test": "vitest run",
    "typecheck": "tsc -p . --noEmit",
    "e2e": "playwright test",
    "lighthouse": "node e2e/lighthouse.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "astro": "7.4.2",
    "happy-dom": "21.0.4",
    "lighthouse": "13.5.0",
    "lucide-static": "1.61.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
