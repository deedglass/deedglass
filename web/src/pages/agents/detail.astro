---
// One agent (S25 §3.7): tabs Overview · Keys · Budgets · Security · Danger zone. src/controllers/agents.ts.
import AppShell from '../../layouts/AppShell.astro';
import { copy } from '../../lib/copy.ts';
const p = copy.pages.agents;
---
<AppShell title={p.title} screen="agents">
  <section id="detail-body" class="detail" aria-busy="true" aria-labelledby="page-title">
    <header class="detail-head" aria-hidden="true">
      <span class="skel skel-line w-32"></span>
      <h1 class="t-title-2" id="page-title"><span class="skel skel-title"></span></h1>
    </header>
    <div class="card card-pad">{[0, 1, 2, 3].map(() => <span class="skel skel-line skel-gap"></span>)}</div>
  </section>
</AppShell>
<script>
  import { bootShell } from '../../controllers/shell.ts';
  import { mountAgent } from '../../controllers/agents.ts';
  bootShell({ title: location.pathname.split('/').pop() ?? 'agents' });
  mountAgent();
</script>
