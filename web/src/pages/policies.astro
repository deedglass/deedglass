---
import ScreenStub from '../components/ScreenStub.astro';
import { copy } from '../lib/copy.ts';
const p = copy.pages.policies;
---
<ScreenStub title={p.title} lede={p.lede} screen="policies" />
<script>
  import { bootShell } from '../controllers/shell.ts';
  import { mountScreen } from '../controllers/screens.ts';
  bootShell({ title: 'Policies' });
  mountScreen('policies');
</script>
