---
// One connector (S26 §3.3): credentials, test, tools; for Postgres the readiness panel and the
// Witness card. src/controllers/connectors.ts.
import AppShell from '../../layouts/AppShell.astro';
import { copy } from '../../lib/copy.ts';
const p = copy.pages.connectors;
---
<AppShell title={p.title} screen="connectors">
  <section id="detail-body" class="detail" aria-busy="true" aria-labelledby="page-title">
    <header class="detail-head" aria-hidden="true">
      <span class="skel skel-line w-32"></span>
      <h1 class="t-title-2" id="page-title"><span class="skel skel-title"></span></h1>
    </header>
    <div class="con-grid">
      <div class="card card-pad">{[0, 1, 2, 3, 4, 5].map(() => <span class="skel skel-line skel-gap"></span>)}</div>
      <div class="card card-pad">{[0, 1, 2].map(() => <span class="skel skel-line skel-gap"></span>)}</div>
    </div>
  </section>
</AppShell>
<script>
  import { bootShell } from '../../controllers/shell.ts';
  import { mountConnector } from '../../controllers/connectors.ts';
  bootShell({ title: location.pathname.split('/').pop() ?? 'connectors' });
  mountConnector();
</script>
