---
// Overview (S25 §3.3): tiles, Needs attention, Agents, Live actions and the Chain card, or the
// first-run flow when the org has no agents. src/controllers/overview.ts fills it from
// GET /v1/overview; the markup here is the loading state in the final geometry.
import AppShell from '../layouts/AppShell.astro';
import { copy } from '../lib/copy.ts';
---
<AppShell title={copy.pages.overview.title} screen="overview">
  <div class="page-head">
    <div>
      <h1 class="t-title-2" id="page-title">{copy.pages.overview.title}</h1>
      <p class="lede" id="page-lede">{copy.pages.overview.lede}</p>
    </div>
    <div class="flex items-center gap-2" id="ov-actions"></div>
  </div>
  <div id="ov-body" aria-busy="true" aria-labelledby="page-title">
    <div class="ov" aria-hidden="true">
      <div class="tiles">
        {[0, 1, 2, 3].map(() => (
          <div class="tile"><span class="skel skel-line w-16"></span><span class="skel skel-metric"></span><span class="skel skel-line w-32"></span></div>
        ))}
      </div>
      <div class="ov-grid">
        <div class="ov-main"><div class="card card-pad">{[0, 1, 2, 3].map(() => <span class="skel skel-line skel-gap"></span>)}</div></div>
        <div class="ov-side"><div class="card card-pad">{[0, 1, 2, 3].map(() => <span class="skel skel-line skel-gap"></span>)}</div></div>
      </div>
    </div>
  </div>
</AppShell>
<script>
  import { bootShell } from '../controllers/shell.ts';
  import { mountOverview } from '../controllers/overview.ts';
  bootShell({ title: 'Overview' });
  mountOverview();
</script>
