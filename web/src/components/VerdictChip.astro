---
// [icon] L2 · VERIFIED (brand §12): caption type, small caps, icon and word always.
import Icon from './Icon.astro';
interface Props { verdict: 'VERIFIED' | 'MISMATCH' | 'UNVERIFIABLE'; level?: 'L0' | 'L1' | 'L2' }
const { verdict, level } = Astro.props;
const m = { VERIFIED: ['chip-verified', 'check'], MISMATCH: ['chip-mismatch', 'x'], UNVERIFIABLE: ['chip-unverifiable', 'circle-dashed'] }[verdict];
const names = { L0: 'Reported', L1: 'Confirmed', L2: 'Witnessed' } as const;
---
<span class:list={['chip', m[0]]} title={level ? `${level} ${names[level]} · ${verdict}` : verdict}><Icon name={m[1] as never} size={16} />{level ? <span>{level}<span class="sep"> · </span>{verdict}</span> : verdict}</span>
