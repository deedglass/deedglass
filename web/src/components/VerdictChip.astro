---
// [icon] Proven · Matches (brand §12, plain names): caption type, small caps, icon and word always.
// The wire values (L2, VERIFIED) stay in the API; the title names them for people who know them.
import Icon from './Icon.astro';
import { copy } from '../lib/copy.ts';
interface Props { verdict: 'VERIFIED' | 'MISMATCH' | 'UNVERIFIABLE'; level?: 'L0' | 'L1' | 'L2' }
const { verdict, level } = Astro.props;
const m = { VERIFIED: ['chip-verified', 'check', copy.chips.verified], MISMATCH: ['chip-mismatch', 'x', copy.chips.mismatch], UNVERIFIABLE: ['chip-unverifiable', 'circle-dashed', copy.chips.unverifiable] }[verdict];
const lv = level ? copy.chips.level[level] : '';
---
<span class:list={['chip', m[0]]} title={level ? `${lv} · ${m[2]} (${level} · ${verdict})` : `${m[2]} (${verdict})`}><Icon name={m[1] as never} size={16} />{level ? <span>{lv}<span class="sep"> · </span>{m[2]}</span> : m[2]}</span>
