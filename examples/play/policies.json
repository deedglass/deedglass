  "object": "play_policies",
  "policies": [
    {
      "object": "play_policy",
      "v": 1,
      "name": "acme-demo",
      "version_hash": "sha256:ba3749af9365d6c850213c6cc8e64483cf79a94b4142011c458bb47969ab53cc",
      "default": {
        "decision": "deny",
        "reason": "No rule allows this action. Add a rule in Console › Policies to allow it."
      },
      "rules": [
        {
          "id": "block-destructive-sql",
          "decision": "deny",
          "reason": "DROP is never allowed for agents.",
          "match_cel": "(glob(tool.name, \"orders.execute_sql\") || glob(tool.name, \"postgres.execute\") || glob(tool.name, \"postgres.query\"))",
          "when_cel": "sql.kind == \"drop\""
        },
        {
          "id": "block-schema-changes",
          "decision": "deny",
          "reason": "Schema changes, privileges, server code and multi-statement SQL are never allowed for agents.",
          "match_cel": "(glob(tool.name, \"orders.execute_sql\") || glob(tool.name, \"postgres.execute\") || glob(tool.name, \"postgres.query\"))",
          "when_cel": "sql.category in [\"ddl\", \"privilege\", \"server_code\", \"unknown\"] || sql.multi || sql.ambiguous"
        },
        {
          "id": "block-unscoped-writes",
          "decision": "deny",
          "reason": "UPDATE and DELETE need a WHERE clause.",
          "match_cel": "(glob(tool.name, \"orders.execute_sql\") || glob(tool.name, \"postgres.execute\") || glob(tool.name, \"postgres.query\"))",
          "when_cel": "sql.unbounded_write"
        },
        {
          "id": "no-deletes-on-orders",
          "decision": "deny",
          "reason": "Agents never delete orders. Set the status to 'cancelled' instead.",
          "match_cel": "(glob(tool.name, \"orders.execute_sql\") || glob(tool.name, \"postgres.execute\") || glob(tool.name, \"postgres.query\"))",
          "when_cel": "sql.kind == \"delete\" || \"delete\" in sql.write_kinds"
        },
        {
          "id": "undo-needs-approval",
          "decision": "require_approval",
          "reason": "Undoing a write changes data again, so a human confirms it first.",
          "match_cel": "glob(tool.name, \"*.undo\") && glob(tool.connector_type, \"postgres\")",
          "when_cel": "true"
        },
        {
          "id": "undo-session-needs-approval",
          "decision": "require_approval",
          "reason": "Undoing a whole session changes data again, so a human confirms it first.",
          "match_cel": "glob(tool.name, \"*.undo_session\") && glob(tool.connector_type, \"postgres\")",
          "when_cel": "true"
        },
        {
          "id": "allow-order-status-updates",
          "decision": "allow",
          "reason": "",
          "match_cel": "glob(tool.name, \"postgres.execute\")",
          "when_cel": "sql.kind == \"update\" && sql.tables == [\"public.orders\"] && sql.tables_complete && !sql.unbounded_write && !sql.multi && !sql.cte_write && size(sql.unknown_functions) == 0"
        },
        {
          "id": "allow-ship-order",
          "decision": "allow",
          "reason": "",
          "match_cel": "glob(tool.name, \"postgres.call\")",
          "when_cel": "has(args.function) && args.function == \"public.ship_order\""
        },
        {
          "id": "orders-writes-need-approval",
          "decision": "require_approval",
          "reason": "Writes to the orders database need a person to countersign.",
          "match_cel": "(glob(tool.name, \"orders.execute_sql\") || glob(tool.name, \"postgres.execute\"))",
          "when_cel": "sql.writes"
        },
        {
          "id": "allow-order-reads",
          "decision": "allow",
          "reason": "",
          "match_cel": "(glob(tool.name, \"orders.execute_sql\") || glob(tool.name, \"postgres.query\"))",
          "when_cel": "sql.category == \"read\" && !sql.writes"
        },
        {
          "id": "allow-schema-browsing",
          "decision": "allow",
          "reason": "",
          "match_cel": "(glob(tool.name, \"orders.get_object_details\") || glob(tool.name, \"orders.list_objects\") || glob(tool.name, \"orders.list_schemas\") || glob(tool.name, \"postgres.describe\"))",
          "when_cel": "true"
        },
        {
          "id": "allow-plain-explain",
          "decision": "allow",
          "reason": "",
          "match_cel": "glob(tool.name, \"orders.explain_query\")",
          "when_cel": "sql.category == \"read\" && !sql.writes && !sql.explain_analyze && !(has(args.analyze) && args.analyze == true)"
        },
        {
          "id": "allow-everything-demo-tools",
          "decision": "allow",
          "reason": "",
          "match_cel": "(glob(tool.name, \"everything.echo\") || glob(tool.name, \"everything.get-annotated-message\") || glob(tool.name, \"everything.get-structured-content\") || glob(tool.name, \"everything.get-sum\") || glob(tool.name, \"everything.get-tiny-image\"))",
          "when_cel": "true"
        },
        {
          "id": "allow-fake",
          "decision": "allow",
          "reason": "",
          "match_cel": "glob(tool.name, \"fake.*\")",
          "when_cel": "true"
        },
        {
          "id": "allow-scratch-reads",
          "decision": "allow",
          "reason": "",
          "match_cel": "(glob(tool.name, \"scratch.directory_tree\") || glob(tool.name, \"scratch.get_file_info\") || glob(tool.name, \"scratch.list_*\") || glob(tool.name, \"scratch.read_*\") || glob(tool.name, \"scratch.search_files\"))",
          "when_cel": "true"
        },
        {
          "id": "scratch-writes-only-in-allowed",
          "decision": "deny",
          "reason": "Agents may only write inside /tmp/deedglass-demo/allowed.",
          "match_cel": "(glob(tool.name, \"scratch.edit_file\") || glob(tool.name, \"scratch.write_file\"))",
          "when_cel": "!has(args.path) || !args.path.startsWith(\"/tmp/deedglass-demo/allowed/\") || args.path.contains(\"..\")"
        },
        {
          "id": "scratch-writes-in-allowed",
          "decision": "allow",
          "reason": "",
          "match_cel": "(glob(tool.name, \"scratch.edit_file\") || glob(tool.name, \"scratch.write_file\"))",
          "when_cel": "true"
        }
      ]
    },
    {
      "object": "play_policy",
      "v": 1,
      "name": "postgres-safe",
      "version_hash": "sha256:60dacb12ffcad375f12600678763913bd15e3e7251aeb69e6bddbbfa83434f47",
      "default": {
        "decision": "deny",
        "reason": "No rule allows this action. Add a rule in Console › Policies to allow it."
      },
      "rules": [
        {
          "id": "block-unclassified-sql",
          "decision": "deny",
          "reason": "Deedglass could not read this SQL with confidence, so it did not run. Send one plain statement.",
          "match_cel": "glob(tool.connector_type, \"postgres\")",
          "when_cel": "sql.present && sql.ambiguous"
        },
        {
          "id": "one-statement-only",
          "decision": "deny",
          "reason": "Send one SQL statement per action. This request had several.",
          "match_cel": "glob(tool.connector_type, \"postgres\")",
          "when_cel": "sql.multi"
        },
        {
          "id": "block-destructive-sql",
          "decision": "deny",
          "reason": "DROP and TRUNCATE are never allowed for agents.",
          "match_cel": "glob(tool.connector_type, \"postgres\")",
          "when_cel": "sql.kind in [\"drop\", \"truncate\"]"
        },
        {
          "id": "block-schema-and-privilege-changes",
          "decision": "deny",
          "reason": "Schema and permission changes never run through agents. Ship them as a reviewed migration.",
          "match_cel": "glob(tool.connector_type, \"postgres\")",
          "when_cel": "sql.category in [\"ddl\", \"privilege\"]"
        },
        {
          "id": "block-server-side-code",
          "decision": "deny",
          "reason": "Server-side code, COPY PROGRAM, and file, network or session functions are never allowed for agents.",
          "match_cel": "glob(tool.connector_type, \"postgres\")",
          "when_cel": "sql.category == \"server_code\" || size(sql.dangerous_functions) > 0"
        },
        {
          "id": "block-unbounded-writes",
          "decision": "deny",
          "reason": "UPDATE and DELETE need a WHERE clause that names the rows to change.",
          "match_cel": "glob(tool.connector_type, \"postgres\")",
          "when_cel": "sql.unbounded_write"
        },
        {
          "id": "allow-reads",
          "decision": "allow",
          "reason": "",
          "match_cel": "glob(tool.name, \"postgres.query\")",
          "when_cel": "sql.category == \"read\" && !sql.writes && !sql.locks_rows && size(sql.unknown_functions) == 0"
        },
        {
          "id": "allow-describe",
          "decision": "allow",
          "reason": "",
          "match_cel": "glob(tool.name, \"postgres.describe\")",
          "when_cel": "true"
        },
        {
          "id": "allow-listed-writes",
          "decision": "allow",
          "reason": "",
          "match_cel": "glob(tool.name, \"postgres.execute\")",
          "when_cel": "sql.kind in [\"insert\", \"update\"] && !sql.cte_write && sql.tables_complete && size(sql.unknown_functions) == 0 && sql.tables.all(t, t in [\"public.support_notes\", \"public.order_tags\"])"
        },
        {
          "id": "writes-need-approval",
          "decision": "require_approval",
          "reason": "Writes to this database wait for a human. An admin can approve in Console › Approvals.",
          "match_cel": "glob(tool.name, \"postgres.execute\")",
          "when_cel": "sql.category == \"write\""
        },
        {
          "id": "functions-need-approval",
          "decision": "require_approval",
          "reason": "Calling a database function changes data, so a human approves it first.",
          "match_cel": "glob(tool.name, \"postgres.call\")",
          "when_cel": "true"
        },
        {
          "id": "undo-needs-approval",
          "decision": "require_approval",
          "reason": "Undoing a write changes data again, so a human confirms it first.",
          "match_cel": "glob(tool.name, \"*.undo\") && glob(tool.connector_type, \"postgres\")",
          "when_cel": "true"
        },
        {
          "id": "undo-session-needs-approval",
          "decision": "require_approval",
          "reason": "Undoing a whole session changes data again, so a human confirms it first.",
          "match_cel": "glob(tool.name, \"*.undo_session\") && glob(tool.connector_type, \"postgres\")",
          "when_cel": "true"
        }
      ]
    }
  ],
  "scene_rules": "rules:\n  - id: writes-need-approval\n    match: { tool: postgres.execute }\n    when: 'sql.kind in [\"update\", \"delete\"]'\n    decision: require_approval\n    reason: Writes to orders need a person.\n",
  "v": 1
}
