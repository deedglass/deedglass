# Deedglass brand preset for VHS (S37 §3.4; VHS v0.12.1, MIT). Every tape sources this file, so
# every frame uses the brand's terminal: Geist Mono 20 px on ink-900 (#0E1017), the brand's ANSI
# colours, nothing else. Real runs only (CLAUDE.md rule 12): tapes drive the running demo stack.
Set Shell bash
Set FontFamily "Geist Mono"
Set FontSize 20
Set Width 1920
Set Height 1080
Set Padding 48
Set Margin 0
Set MarginFill "#07080C"
Set BorderRadius 20
Set TypingSpeed 45ms
Set CursorBlink false
Set Framerate 30
Set Theme { "name": "deedglass-dark", "background": "#0E1017", "foreground": "#F5F6FA", "cursor": "#6F8DFF", "cursorAccent": "#07080C", "selection": "#2A2E3B", "black": "#07080C", "brightBlack": "#8B90A0", "red": "#FF7A70", "brightRed": "#FF7A70", "green": "#34E3C9", "brightGreen": "#34E3C9", "yellow": "#F7B955", "brightYellow": "#E0C48A", "blue": "#6F8DFF", "brightBlue": "#8AA2FF", "magenta": "#A99CFF", "brightMagenta": "#A99CFF", "cyan": "#9FD8CE", "brightCyan": "#9FD8CE", "white": "#C9CCD6", "brightWhite": "#F5F6FA" }
