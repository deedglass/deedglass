{
  "mcpServers": {
    "deedglass": {
      "command": "/Users/you/txv/product/bin/deedglass",
      "args": [
        "mcp",
        "serve",
        "--connector",
        "native"
      ],
      "env": {
        "DEEDGLASS_API_KEY": "dg_test_REPLACE_ME",
        "DEEDGLASS_SERVER": "http://127.0.0.1:8080"
      }
    },
    "orders": {
      "command": "/Users/you/txv/product/bin/deedglass",
      "args": [
        "mcp",
        "wrap",
        "--connector",
        "orders",
        "--connector-type",
        "postgres",
        "--",
        "/usr/local/bin/docker",
        "run",
        "-i",
        "--rm",
        "--init",
        "-e",
        "DATABASE_URI",
        "crystaldba/postgres-mcp:0.3.0@sha256:dbbd346860d29f1543e991f30f3284bf4ab5f096d049ecc3426528f20b1b6e6b",
        "--access-mode=unrestricted"
      ],
      "env": {
        "DATABASE_URI": "postgresql://acme_owner:ACME_OWNER_PASSWORD@localhost:55434/acme",
        "DEEDGLASS_API_KEY": "dg_test_REPLACE_ME",
        "DEEDGLASS_SERVER": "http://127.0.0.1:8080",
        "PATH": "/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin"
      }
    },
    "orders-direct": {
      "command": "/usr/local/bin/docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "--init",
        "-e",
        "DATABASE_URI",
        "crystaldba/postgres-mcp:0.3.0@sha256:dbbd346860d29f1543e991f30f3284bf4ab5f096d049ecc3426528f20b1b6e6b",
        "--access-mode=unrestricted"
      ],
      "env": {
        "DATABASE_URI": "postgresql://acme_owner:ACME_OWNER_PASSWORD@localhost:55434/acme",
        "PATH": "/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin"
      }
    },
    "scratch": {
      "command": "/Users/you/txv/product/bin/deedglass",
      "args": [
        "mcp",
        "wrap",
        "--connector",
        "scratch",
        "--",
        "/opt/homebrew/bin/npx",
        "-y",
        "@modelcontextprotocol/server-filesystem@2026.8.31",
        "/tmp/deedglass-demo"
      ],
      "env": {
        "DEEDGLASS_API_KEY": "dg_test_REPLACE_ME",
        "DEEDGLASS_SERVER": "http://127.0.0.1:8080",
        "PATH": "/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin"
      }
    }
  }
}
