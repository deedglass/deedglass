# The Acme demo stack's local settings. make demo-up writes examples/demo/.env (mode 0600,
# git-ignored) with random values on first run; you never need to edit it. Local demos only:
# these passwords protect containers bound to 127.0.0.1 and are not credentials for anything else.
DEEDGLASS_DEV_PG_ADMIN_PASSWORD=
DEEDGLASS_DEV_PG_MIGRATOR_PASSWORD=
DEEDGLASS_DEV_PG_APP_PASSWORD=
DEEDGLASS_VAULT_KEY=
DEEDGLASS_API_KEY_PEPPER=
ORDERS_DB_PASSWORD=
ACME_OWNER_PASSWORD=
# The seal key file make demo-up created in examples/demo/.demo/keys/.
DEMO_SEAL_KEY=
# The Deedglass server's port on 127.0.0.1 (make demo-up DEMO_PORT=8091 if 8080 is taken).
DEMO_PORT=8080
