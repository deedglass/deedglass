# Build context for the root Dockerfile. Secrets never enter a layer: local settings, dev secrets and
# key files stay out. Only .env.example (no real values) is allowed through.
.git
.github
.env*
!.env.example
.deedglass/
*.key
*.pem
bin/
.tmp/
bench/results/
coverage.*
*.out
*.test
.DS_Store
.idea/
.vscode/
# Dev tool trees (about 1.7 GB on a working copy): the image builds Go only, so they never enter the context.
**/node_modules/
**/.venv/
