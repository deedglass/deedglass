# Install: deedglass completion fish > ~/.config/fish/completions/deedglass.fish
function __deedglass_path
    set -l known '|a2a|a2a proxy|act|actions|actions cancel|actions list|actions show|agent|agent create|agent intent|agent intent add|agent intent keygen|agent intent list|agent intent mode|agent intent remove|agent keys|agent keys create|agent keys list|agent keys revoke|agent keys roll|agent list|agent resume|agent show|agent start|agent stop|agent suspend|approvals|approvals list|approvals open|approvals show|approve|clients|completion|completion bash|completion fish|completion zsh|config|config print|connect|connector|connector create|connector credentials|connector credentials remove|connector credentials set|connector gmail|connector gmail authorize|connector list|connector postgres|connector postgres check|connector postgres init|connector show|connector test|connector types|decoder|decoder drop|decoder status|deeds|deeds export|deeds list|deeds seal-file|deeds share|deeds show|deeds timestamp|deny|dev|dev agent-script|dev fake-action|dev mail-preview|dev seed|dev sign-intent|dev simulate|dev stripe-fixtures|doctor|export|guard|guard shell|health|health pilot|help|init|insights|insights anomalies|insights detect|insights digest|insights settings|insights shadow|insights stats|insights suggestions|insights suggestions accept|insights suggestions generate|insights suggestions list|insights suggestions reject|insights suggestions show|keys|keys gen|keys list|keys rotate|ledger|ledger check|ledger prune|licence|licence activate|licence deactivate|licence refresh|licence show|lockdown|lockdown ack|lockdown off|lockdown on|lockdown status|mcp|mcp install-links|mcp serve|mcp snippet|mcp wrap|migrate|migrate status|migrate up|migrate verify|observe|observe exclude|observe list|observe run|observe show|observe start|observe stop|observe undo|org|org create|org keys|org keys create|org keys list|org keys revoke|org login-link|org start-all|org stop-all|play|policy|policy activate|policy diff|policy evaluate|policy fmt|policy install|policy lint|policy packs|policy packs list|policy packs verify|policy push|policy replay|policy test|protect|report|scan|security-pack|security-pack build|security-pack readiness|security-pack verify|serve|slack|slack manifest|start|undo|undo preview|undo run|vault|vault rotate|vault status|verify|version|webhooks|webhooks create|webhooks delete|webhooks list|webhooks test|witness|witness debezium|'
    set -l path ""
    for w in (commandline -opc)[2..-1]
        string match -q -- '-*' $w; and continue
        set -l next (string trim -- "$path $w")
        string match -q -- "*|$next|*" $known; and set path $next
    end
    echo $path
end
function __deedglass_is
    test (__deedglass_path) = "$argv[1]"
end
