#compdef deedglass
# zsh completion for deedglass. Generated by: deedglass completion zsh
# Install: deedglass completion zsh > "${fpath[1]}/_deedglass", then start a new shell.
_deedglass() {
  local w path="" known='|act|actions|actions cancel|actions list|actions show|agent|agent create|agent intent|agent intent add|agent intent keygen|agent intent list|agent intent mode|agent intent remove|agent keys|agent keys create|agent keys list|agent keys revoke|agent keys roll|agent list|agent resume|agent show|agent start|agent stop|agent suspend|approvals|approvals list|approvals show|approve|completion|completion bash|completion fish|completion zsh|config|config print|connector|connector create|connector credentials|connector credentials remove|connector credentials set|connector gmail|connector gmail authorize|connector list|connector postgres|connector postgres check|connector postgres init|connector show|connector test|connector types|decoder|decoder drop|decoder status|deeds|deeds export|deeds list|deeds seal-file|deeds share|deeds show|deny|dev|dev agent-script|dev fake-action|dev mail-preview|dev seed|dev sign-intent|dev simulate|dev stripe-fixtures|doctor|help|init|insights|insights anomalies|insights detect|insights digest|insights settings|insights shadow|insights stats|insights suggestions|insights suggestions accept|insights suggestions generate|insights suggestions list|insights suggestions reject|insights suggestions show|keys|keys gen|keys list|keys rotate|ledger|ledger check|ledger prune|licence|licence activate|licence deactivate|licence refresh|licence show|mcp|mcp install-links|mcp serve|mcp snippet|mcp wrap|migrate|migrate status|migrate up|migrate verify|observe|observe exclude|observe list|observe run|observe show|observe start|observe stop|observe undo|org|org create|org keys|org keys create|org keys list|org keys revoke|org login-link|org start-all|org stop-all|policy|policy activate|policy diff|policy evaluate|policy fmt|policy install|policy lint|policy packs|policy packs list|policy packs verify|policy push|policy replay|policy test|scan|serve|slack|slack manifest|undo|undo preview|undo run|vault|vault rotate|vault status|verify|version|webhooks|webhooks create|webhooks delete|webhooks list|webhooks test|'
  local -a subs flags
  for w in "${(@)words[2,CURRENT-1]}"; do
    [[ $w == -* ]] && continue
    [[ $known == *"|${path:+$path }$w|"* ]] && path="${path:+$path }$w"
  done
  case "$path ${words[CURRENT-1]}" in
    'init --client') compadd -- claude-code claude-desktop cursor vscode windsurf sdk-python sdk-typescript none; return ;;
    'init --postgres') compadd -- docker; return ;;
    'scan --fail-under') compadd -- A B C D; return ;;
    'scan --format') compadd -- md html json sarif; return ;;
  esac
  case "$path" in
    '')
      subs=( 'init:Set up Deedglass in this directory' 'doctor:Check config, database and keys' 'scan:Show what your agent setup can change' 'serve:Run the API, the rules and the Console' 'migrate:Apply or check database migrations' 'config:Commands for config' 'version:Show the client and server versions' 'keys:Manage seal keys' 'licence:Turn on Pro, or check this machine'\''s licence' 'vault:Check or rotate the credential vault' 'help:Show help for deedglass or one command' 'completion:Print shell completion' 'agent:Register and control agents' 'org:Create orgs and keys; stop or start all' 'policy:Write, test and activate policies' 'act:Send a test action through Deedglass' 'actions:Inspect actions' 'approve:Approve a pending action' 'deny:Deny a pending action' 'approvals:List pending approvals' 'undo:Preview or run an undo' 'observe:Watch what changed while an agent ran' 'webhooks:Send events to your endpoints' 'verify:Check records offline' 'deeds:Browse and export records' 'ledger:Check or prune the Ledger' 'connector:Connect tools' 'decoder:Inspect Postgres change readers' 'slack:Commands for slack' 'mcp:Put Deedglass in front of MCP servers' 'insights:Suggestions, shadow results and anomalies' 'dev:Local helpers' )
      ;;
    'actions')
      subs=( 'list:List actions' 'show:Show one action, its events and its Proven diff' 'cancel:Cancel a pending action' )
      ;;
    'actions list')
      flags=( '--agent:an agent id (agt_…)' '--connector:only this connector'\''s tools (<connector>.*)' '--cursor:next_cursor from the previous page' '--decision:comma list\: allow, deny, require_approval' '--follow:keep printing actions as they are decided and sealed (Ctrl-C to stop)' '--level:comma list\: L0, L1, L2' '--limit:page size, 1 to 100' '--on-behalf-of:an on-behalf-of reference' '-q:text in the tool name or error code' '--since:only actions newer than this (1h, 30m)' '--state:comma list of states' '--tool:a tool name, or a glob with * (stripe.*)' '--verdict:comma list\: VERIFIED, MISMATCH, UNVERIFIABLE' )
      ;;
    'agent')
      subs=( 'create:Register an agent' 'list:List agents' 'show:Show one agent' 'suspend:Suspend an agent' 'resume:Resume a suspended agent' 'stop:Stop an agent now' 'start:Start a stopped agent' 'keys:Manage an agent'\''s API keys' 'intent:Manage an agent'\''s signed-intent keys' )
      ;;
    'agent create')
      flags=( '--calls-per-day:budget\: calls per day' '--calls-per-minute:budget\: calls per minute (S11 enforces it)' '--currency:the spend budget'\''s ISO 4217 currency, lowercase' '--description:what the agent does, up to 500 characters' '--label:a label key=value (repeatable)\: env=prod' '--owner:the person responsible (usr_…)' '--spend-per-day:budget\: spend per day in minor units (5000 = $50.00), with --currency' )
      ;;
    'agent intent')
      subs=( 'keygen:Generate a signed-intent key pair' 'add:Register an intent public key' 'list:List an agent'\''s intent keys' 'remove:Remove an intent key' 'mode:Require, allow or ignore signed intents' )
      ;;
    'agent intent add')
      flags=( '--public-key:the public key keygen printed, "ed25519\:…"' )
      ;;
    'agent intent keygen')
      flags=( '--dir:where to write <agent>.pem (created with mode 0700)' '--force:replace an existing key file' )
      ;;
    'agent keys')
      subs=( 'create:Create an API key for an agent' 'list:List an agent'\''s API keys' 'roll:Replace an API key, with an overlap' 'revoke:Revoke an API key' )
      ;;
    'agent keys create')
      flags=( '--mode:live or test (test keys are recorded as livemode false)' '--name:a name for the key, like prod runner' '--scope:a scope (repeatable); default actions\:execute, actions\:read, deeds\:read' )
      ;;
    'agent keys revoke')
      flags=( '--reason:why; it goes into the record (required for start)' )
      ;;
    'agent keys roll')
      flags=( '--overlap:how long the old key keeps working\: 0s to 168h' )
      ;;
    'agent list')
      flags=( '--label:only agents with this label, key\:value (env\:prod)' '--status:active, suspended or stopped' )
      ;;
    'agent resume')
      flags=( '--reason:why; it goes into the record (required for start)' )
      ;;
    'agent start')
      flags=( '--reason:why; it goes into the record (required for start)' )
      ;;
    'agent stop')
      flags=( '--reason:why; it goes into the record (required for start)' )
      ;;
    'agent suspend')
      flags=( '--reason:why; it goes into the record (required for start)' )
      ;;
    'approvals')
      subs=( 'list:List approvals' 'show:Show one approval' )
      ;;
    'approvals list')
      flags=( '--agent:an agent id or name' '--limit:at most this many (1 to 100)' '--status:pending, approved, denied, expired, cancelled, or a comma-separated list' )
      ;;
    'approve')
      flags=( '--as:dev only\: the member who decides (their email)' '--reason:why (required to deny; the agent sees it)' )
      ;;
    'completion')
      subs=( 'zsh:Print zsh completion' 'bash:Print bash completion' 'fish:Print fish completion' )
      ;;
    'config')
      subs=( 'print:Show the effective config, secrets hidden' )
      ;;
    'connector')
      subs=( 'create:Add a connector' 'list:List connectors' 'show:Show one connector' 'test:Test a connector'\''s credentials' 'types:List connector types' 'credentials:Commands for connector credentials' 'postgres:Prepare a Postgres database' 'gmail:Authorize the Gmail connector' )
      ;;
    'connector create')
      flags=( '--config:a YAML or JSON file\: the config, or a document with type, name and config' '--description:what the connector is for, up to 500 characters' '--name:the connector name, used as the tool prefix\: orders → orders.get' '--type:the connector type (rest)' )
      ;;
    'connector credentials')
      subs=( 'set:Store a connector'\''s credentials' 'remove:Delete a connector'\''s credentials' )
      ;;
    'connector gmail')
      subs=( 'authorize:Authorize the Gmail connector' )
      ;;
    'connector gmail authorize')
      flags=( '--client-file:the Desktop-app OAuth client JSON from Google Cloud' '--no-browser:print the sign-in link instead of opening a browser' '--readonly:also ask for gmail.readonly, so agents can read threads (gmail.get_thread)' )
      ;;
    'connector postgres')
      subs=( 'init:Prepare a Postgres database' 'check:Check a prepared Postgres database' )
      ;;
    'connector postgres check')
      flags=( '--config:local mode\: the connector'\''s config file (else read from the server)' '--connector:the postgres connector'\''s name' '--dsn-env:local mode\: check with the DSN in this environment variable instead of the server' '--probe:local mode\: run begin_action in a transaction that is rolled back' '--witness-dsn-env:local mode\: the witness DSN'\''s environment variable' )
      ;;
    'connector postgres init')
      flags=( '--admin-dsn-env:the environment variable holding the admin DSN (read once, never stored)' '--apply:apply the plan in one transaction' '--config:read the connector'\''s config from this YAML or JSON file instead of the server' '--confirm:the database name, typed exactly\: required to apply to a remote, non-throwaway database' '--connector:the postgres connector'\''s name' '--dsn-host:host\:port the Deedglass server reaches the database at, when it differs from the admin DSN'\''s (a Docker service name, a private DNS name)' '--no-store:write the DSNs to .deedglass/pg-<connector>.env instead of the vault' '--plan-dir:where the reviewable plan is written' '--rotate-passwords:give deedglass_agent and deedglass_witness new passwords and store new DSNs' )
      ;;
    'connector types')
      flags=( '--type:show one type\: its tools, credentials, setup and limits' )
      ;;
    'decoder')
      subs=( 'status:Show what the decoder reads from Postgres' 'drop:Drop a connector'\''s replication slot' )
      ;;
    'decoder drop')
      flags=( '--confirm:the connector'\''s name again, instead of typing it (scripts)' '--connector:the connector whose slot to drop' )
      ;;
    'decoder status')
      flags=( '--connector:one connector'\''s decoder, in detail' '--recent:show the newest N frames (0 to 50; with --connector)' )
      ;;
    'deeds')
      subs=( 'list:List records' 'show:Show one record' 'share:Make a link that checks one record' 'export:Export records as a bundle' 'seal-file:Seal a file'\''s hash as a record' )
      ;;
    'deeds export')
      flags=( '--format:tar.gz (a sealed bundle) or jsonl (records only)' '--from-seq:first seq' '--out:file to write (default deedglass-<org>-<first>-<last>.tar.gz)' '--since:only records issued in the last 1h, 30m, … (S13)' '--to-seq:last seq' )
      ;;
    'deeds list')
      flags=( '--action:an action id\: its record and amendments' '--cursor:next_cursor from the previous page' '--from-seq:first seq' '--kind:comma list\: action, admin, amendment' '--limit:page size, 1 to 100' '--order:asc (default) or desc' '--to-seq:last seq' )
      ;;
    'deeds share')
      flags=( '--yes:make the link without asking' )
      ;;
    'deny')
      flags=( '--as:dev only\: the member who decides (their email)' '--reason:why (required to deny; the agent sees it)' )
      ;;
    'dev')
      subs=( 'seed:Load demo data into a dev database' 'fake-action:Seal realistic fake actions (dev only)' 'simulate:Simulate a week of agent traffic (dev only)' 'agent-script:Run a scripted agent' 'mail-preview:Preview emails in the browser' 'sign-intent:Sign an intent with a local key' 'stripe-fixtures:Create Stripe sandbox fixtures' )
      ;;
    'dev fake-action')
      flags=( '--agents:how many demo agents (1 to 8)' '--batch:actions per transaction (500 for bulk seeding)' '--kinds:comma list\: allow, deny, mismatch, unverifiable, failed, pending, amend' '-n:how many actions' '--org-slug:the demo org'\''s slug (created when missing); --org picks an existing org instead' '--pace:pause between actions for live demos (200ms)' '--quiet:print only the final line' '--seed:the same seed gives the same tools, arguments, latencies and verdicts' )
      ;;
    'dev mail-preview')
      flags=( '--out:write the HTML to this file (default\: a temporary file)' )
      ;;
    'dev seed')
      flags=( '--approver:with --demo\: add this email as an admin of the demo org, so approval emails reach it (S22)' '--demo:load the Acme demo org, agents, keys and policy instead (S15)' '--keys-file:with --demo\: where the agents'\'' keys are written (0600)' )
      ;;
    'dev sign-intent')
      flags=( '--agent:the agent'\''s id (agt_…); from whoami when an API key is set' '--args:the exact JSON arguments, like '\''{"amount"\:1200}'\''' '--explain:show every step\: args, digest, intent, hash, header' '--key:the PKCS#8 PEM private key keygen wrote' '--nonce:use this nonce, 32 lowercase hex (tests and vectors)' '--now:sign as of this RFC 3339 time (tests and vectors)' '--obo:sign Deedglass-On-Behalf-Of\: the person the agent serves' '--session:sign Deedglass-Session\: the conversation or run' '--tool:the connector.tool name, like stripe.refund' '--ttl:how long the intent is valid, at most 5m' )
      ;;
    'dev simulate')
      flags=( '--append:add days to an existing simulated org instead of creating a fresh one' '--days:how many days to simulate (1 to 90)' '--end:when the window ends\: now, -2d, -12h, or an RFC 3339 time (truncated to the org-local hour)' '--org:with --append\: the simulated org (org_…)' '--org-slug:the fresh org'\''s slug (default the scenario'\''s), or with --append the org to add to' '--pace:pause between actions (live demos, like 200ms)' '--quiet:print only the result line' '--scenario:the scenario file (default\: the embedded examples/sim/acme.yaml)' '--seed:the same seed and scenario give the same tools, arguments, times, outcomes and approval waits' )
      ;;
    'dev stripe-fixtures')
      flags=( '--connector:the Stripe connector'\''s name (for messages)' '--from-env:the environment variable holding a sandbox key (rk_test_ or sk_test_)' '--out:where to write the ids (mode 0600)' )
      ;;
    'doctor')
      flags=( '--only:run only these checks\: ids or prefixes, like db.* or seal.key,clock.skew' )
      ;;
    'init')
      flags=( '--client:the agent client to connect\: claude-code, claude-desktop, cursor, vscode, windsurf, sdk-python, sdk-typescript, none' '--dir:the directory to set up (.deedglass/ goes here)' '--listen:where deedglass serve listens' '--no-open:don'\''t open the Console' '--no-smoke:skip the three smoke actions' '--owner-email:the local org'\''s owner' '--pg-port:the local Postgres port (127.0.0.1)' '--postgres:where Postgres runs\: docker' '--project:the Docker name prefix (default\: from the directory)' '--reset-secrets:replace the vault key and pepper (asks you to type reset; every API key stops working)' '--smoke:run the smoke actions even when nothing changed' '--stop:stop the local stack this directory runs (the data is kept)' '--yes:don'\''t ask; run every step' )
      ;;
    'insights')
      subs=( 'stats:Show decisions, approvals and verdicts by rule' 'shadow:Show where the shadow policy disagrees' 'anomalies:List anomalies' 'detect:Run anomaly detection now' 'settings:Show or change Insights settings' 'suggestions:Commands for insights suggestions' 'digest:Preview the weekly digest' )
      ;;
    'insights suggestions')
      subs=( 'list:List suggestions' 'show:Show one suggestion' 'accept:Accept a suggestion into shadow' 'reject:Reject a suggestion' 'generate:Generate suggestions now' )
      ;;
    'keys')
      subs=( 'gen:Generate a seal key' 'rotate:Rotate the active seal key' 'list:List seal keys' )
      ;;
    'keys gen')
      flags=( '--dir:directory for the key file (default .deedglass/keys)' '--purpose:seal (a deed seal key), licence (an lk_ key that signs licence tokens, never deeds) or packs (the key that signs the policy-packs index)' )
      ;;
    'keys rotate')
      flags=( '--dir:directory for the new key file (default\: next to DEEDGLASS_SEAL_KEY_FILE, else .deedglass/keys)' '--overlap:how long the old key keeps sealing (1s to 168h)' )
      ;;
    'ledger')
      subs=( 'check:Check the record chain' 'prune:Remove old payloads; records stay' )
      ;;
    'ledger check')
      flags=( '--from-seq:first seq (default\: the whole chain)' '--to-seq:last seq' )
      ;;
    'ledger prune')
      flags=( '--dry-run:count only; nothing changes' '--older-than:payload age to remove (90d, 24h; default\: the org'\''s retention, 90 days)' '--yes:don'\''t ask for confirmation' )
      ;;
    'licence')
      subs=( 'activate:Turn on Pro with the key from Dodo' 'show:Show this machine'\''s licence, offline' 'refresh:Check the licence with Dodo now' 'deactivate:Remove the licence from this machine' )
      ;;
    'mcp')
      subs=( 'wrap:Run an MCP server behind Deedglass' 'serve:Serve Deedglass'\''s native MCP tools' 'snippet:Print client config for an MCP client' 'install-links:Print every one-click install link' )
      ;;
    'mcp serve')
      flags=( '--connector:native, or the name of an upstream MCP server (mcp.upstreams)' )
      ;;
    'migrate')
      subs=( 'up:Apply database migrations' 'status:Show applied and pending migrations' 'verify:Check applied migrations against this build' )
      ;;
    'migrate status')
      flags=( '--database-url:the migrator role'\''s Postgres URL (default DEEDGLASS_MIGRATE_DATABASE_URL)' )
      ;;
    'migrate up')
      flags=( '--database-url:the migrator role'\''s Postgres URL (default DEEDGLASS_MIGRATE_DATABASE_URL)' '--dry-run:show what would be applied, and apply nothing' )
      ;;
    'migrate verify')
      flags=( '--database-url:the migrator role'\''s Postgres URL (default DEEDGLASS_MIGRATE_DATABASE_URL)' )
      ;;
    'observe')
      subs=( 'run:Watch a database while a command runs' 'start:Open a watched session' 'stop:Close a watched session' 'list:List watched sessions' 'show:Show a session or print its undo SQL' 'undo:Undo a whole session in one step (Pro)' 'exclude:Leave a transaction out of an undo' )
      ;;
    'org')
      subs=( 'create:Create an org and its owner' 'login-link:Print a one-time sign-in link' 'keys:Commands for org keys' 'stop-all:Stop every agent in the org' 'start-all:Start every agent not stopped one by one' )
      ;;
    'org create')
      flags=( '--admin-key:also create an org admin key and print it once (S08)' '--name:the org'\''s name, as people see it (required)' '--owner-email:the first owner'\''s email address (required)' '--print-link:prod\: print the owner'\''s sign-in link instead of emailing it' '--slug:the org'\''s short name in URLs (default\: from the name)' )
      ;;
    'org keys')
      subs=( 'create:Create an org admin key' 'list:List org admin keys' 'revoke:Revoke an org admin key' )
      ;;
    'org keys create')
      flags=( '--mode:live or test' '--name:a name for the key, like ci' )
      ;;
    'org keys revoke')
      flags=( '--reason:why; it goes into the record (required for start)' )
      ;;
    'org login-link')
      flags=( '--email:the member'\''s email address (required); --org picks the org' )
      ;;
    'org start-all')
      flags=( '--reason:why; it goes into the record (required for start)' )
      ;;
    'org stop-all')
      flags=( '--reason:why; it goes into the record' '--yes:skip the typed confirmation (scripts)' )
      ;;
    'policy')
      subs=( 'lint:Check a policy file' 'fmt:Format a policy file' 'test:Run a policy'\''s test cases' 'push:Upload a new policy version' 'activate:Activate a policy version' 'evaluate:Evaluate one action against a policy' 'replay:Replay past actions against a version' 'diff:Compare two policy versions' 'install:Install a policy pack as files' 'packs:List or check the policy packs' )
      ;;
    'policy packs')
      subs=( 'list:List the policy packs' 'verify:Check the packs against their signed index' )
      ;;
    'scan')
      flags=( '--badge:write .deedglass/score.json (a shields.io endpoint) and print the README line' '--ci:for CI\: no user configs, no colour, no mark, never a prompt' '--dir:the directory to scan' '--fail-under:exit 1 when the grade is below this one\: A, B, C or D' '--format:report files to write\: md, html, json, sarif (comma-separated)' '--full:also write deedglass-full-report.html, the full scan report (Pro or the $29 report; checks the licence)' '--max-files:stop the file walk after this many files' '--no-seal:with --full\: don'\''t seal the report on your Deedglass server' '--no-write:print only; write no report files' '--out-dir:where the report files go' '--postgres-dsn-env:the environment variable holding a Postgres URL to check read-only (never a URL itself)' '--score:print the score line, the small print and the deductions only' '--share:print a share link that holds the grade, counts and finding ids only' '--user-configs:also read your user-level MCP client configs (Claude Desktop, Cursor, Windsurf)' )
      ;;
    'serve')
      flags=( '--migrate:dev only\: apply pending migrations first (DEEDGLASS_MIGRATE_DATABASE_URL)' )
      ;;
    'slack')
      subs=( 'manifest:Print the Slack app manifest' )
      ;;
    'slack manifest')
      flags=( '--base-url:your Deedglass server'\''s public HTTPS URL, like https\://deedglass.example.com' '--name:the app'\''s name in Slack (at most 35 characters)' )
      ;;
    'undo')
      subs=( 'preview:Show what an undo would change' 'run:Undo an action' )
      ;;
    'vault')
      subs=( 'status:Show the credential vault'\''s keys' 'rotate:Re-encrypt credentials with a new key' )
      ;;
    'verify')
      flags=( '--all:list every failure (at most 100) instead of stopping at the first' '--anchor:<seq>\:sha256\:… the body_hash of the deed just before the first one given' '--file:also check this file against the deed (a deed from deedglass deeds seal-file)' '--keys:seal key set\: a keys.json file or an https URL (repeatable)' '--max-bytes:the largest deeds.jsonl a bundle may hold' '--pin:accept only seal keys with this thumbprint, sha256\:… (repeatable)' '-q:print nothing; the exit code is the answer' '--quiet:print nothing; the exit code is the answer' '--strict:require canonical bytes and pinned keys' )
      ;;
    'version')
      flags=( '--check:ask GitHub'\''s releases API whether a newer version exists (opt-in; sends only a User-Agent)' '--pre:with --check, count prereleases too' '-q:no banner' '--quiet:no banner' )
      ;;
    'webhooks')
      subs=( 'create:Add a webhook endpoint' 'list:List webhook endpoints' 'test:Send a test event' 'delete:Remove a webhook endpoint' )
      ;;
    'webhooks create')
      flags=( '--description:a note for people, at most 200 characters' '--events:comma-separated event types, for example approval.requested,approval.decided' '--url:the endpoint (https; http\://localhost in dev)' )
      ;;
  esac
  flags+=( '--json:print JSON' '--server:the Deedglass server URL' '--api-key:an API key (else DEEDGLASS_API_KEY)' '--org:the org, for operator commands' '--no-color:no colour' '-v:more detail' )
  if [[ $PREFIX == -* ]]; then
    _describe -t flags 'flag' flags
  elif (( ${#subs} )); then
    _describe -t commands 'deedglass command' subs
  else
    _files
  fi
}
if [[ $funcstack[1] == _deedglass ]]; then
  _deedglass "$@"
else
  compdef _deedglass deedglass
fi
