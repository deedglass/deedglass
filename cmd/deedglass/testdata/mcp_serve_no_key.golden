dOnlyHint":true},"description":"Run one read-only SQL statement against public and get up to 500 rows back. Read-only: it never commits.","inputSchema":{"type":"object","additionalProperties":false,"required":["sql"],"properties":{"sql":{"type":"string","maxLength":65536,"description":"One read-only SQL statement (SELECT). Use $1, $2 … for values."},"params":{"type":"array","items":{},"description":"Values for $1, $2 …: strings, integers, booleans or null; at most 100."},"limit":{"type":"integer","minimum":1,"maximum":500,"description":"Return at most this many rows (default and maximum 500)."}}},"name":"postgres_query","title":"Query"},{"name":"deedglass_check_approval","title":"Check a Deedglass approval","description":"Checks whether a person has countersigned an action that Deedglass paused for approval. Call it with the approval_id from a 'Waiting for approval' message. It waits up to wait_seconds (0 to 20, default 10) for the decision, so one call is usually enough. If it was approved, Deedglass runs the original tool call and returns its result. Nothing runs while the approval is pending.","inputSchema":{"type":"object","additionalProperties":false,"required":["approval_id"],"properties":{"approval_id":{"type":"string","pattern":"^apr_[0-9a-hjkmnp-tv-z]{26}$","description":"The approval id, for example apr_01j9zs4k7m2n3p5q6r7s8t9v0w"},"wait_seconds":{"type":"integer","minimum":0,"maximum":20,"default":10,"description":"How long to wait for a person's decision before answering, in seconds."}}},"annotations":{"readOnlyHint":false,"idempotentHint":true,"openWorldHint":false}}]}}
