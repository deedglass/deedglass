exit 0
--- stdout
display_information:
  name: Deedglass
  description: "Approvals and agent messages, sealed as deeds."
  background_color: "#07080C"
features:
  bot_user:
    display_name: deedglass
    always_online: false
oauth_config:
  scopes:
    bot:
      - chat:write          # post approval cards and agent messages, and edit the cards
      - channels:read       # resolve public channel names to ids
      - groups:read         # resolve private channels the bot is in
      - channels:history    # read back a posted message (L1) in public channels
      - groups:history      # read back a posted message (L1) in private channels
      - reactions:read      # read back a reaction (L1)
      - reactions:write     # the add_reaction tool
      - users:read          # who clicked Approve or Deny
      - users:read.email    # match that person to an org member by confirmed email
settings:
  interactivity:
    is_enabled: true
    request_url: "https://example.test/v1/slack/interact"
  org_deploy_enabled: false
  socket_mode_enabled: false
  token_rotation_enabled: false
--- stderr
