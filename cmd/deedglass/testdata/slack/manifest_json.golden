{"object":"slack_manifest","request_url":"https://example.test/v1/slack/interact","name":"Deedglass","manifest":"display_information:\n  name: Deedglass\n  description: \"Approvals and agent messages, sealed as deeds.\"\n  background_color: \"#07080C\"\nfeatures:\n  bot_user:\n    display_name: deedglass\n    always_online: false\noauth_config:\n  scopes:\n    bot:\n      - chat:write          # post approval cards and agent messages, and edit the cards\n      - channels:read       # resolve public channel names to ids\n      - groups:read         # resolve private channels the bot is in\n      - channels:history    # read back a posted message (L1) in public channels\n      - groups:history      # read back a posted message (L1) in private channels\n      - reactions:read      # read back a reaction (L1)\n      - reactions:write     # the add_reaction tool\n      - users:read          # who clicked Approve or Deny\n      - users:read.email    # match that person to an org member by confirmed email\nsettings:\n  interactivity:\n    is_enabled: true\n    request_url: \"https://example.test/v1/slack/interact\"\n  org_deploy_enabled: false\n  socket_mode_enabled: false\n  token_rotation_enabled: false\n"}
