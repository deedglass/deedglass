{{template "head" .}}<h1 class="dg-text" style="text-wrap:balance;margin:0 0 16px 0;font-size:22px;line-height:30px;font-weight:600;letter-spacing:-0.02em;color:#0D0F14;">Sign in to {{.OrgName}}</h1>
<p style="margin:0 0 24px 0;">Use the button to sign in as {{.Email}}. The link works once and expires in {{.ExpiresIn}}.</p>
{{template "button" button .Link "Sign in to Deedglass"}}<p class="dg-muted" style="margin:0 0 8px 0;font-size:13px;line-height:20px;color:#6B7080;">Or enter this code on the sign-in page:</p>
<p style="margin:0 0 24px 0;"><span class="dg-code" translate="no" style="display:inline-block;padding:6px 12px;background-color:#EDEEF2;border-radius:6px;font-family:'Geist Mono',ui-monospace,Menlo,monospace;font-size:22px;line-height:30px;letter-spacing:0.12em;font-variant-numeric:tabular-nums;color:#0D0F14;">{{.Code}}</span></p>
{{if .Requested}}<p class="dg-muted" style="margin:0 0 8px 0;font-size:13px;line-height:20px;color:#6B7080;">{{.Requested}}</p>
{{end}}<p class="dg-muted" style="margin:0;font-size:13px;line-height:20px;color:#6B7080;">If you didn't ask to sign in, you can ignore this email. Nothing happens until someone uses the link or the code.</p>
{{template "foot" .}}
