{
    "permissions": {
        "allow": [
            "Bash(npm test)"
        ],
        "defaultMode": "acceptEdits"
    },
    "env": {
        "FOO": "1"
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Edit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "./lint.sh"
                    }
                ]
            },
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "/usr/local/bin/deedglass guard shell",
                        "timeout": 10
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "say done"
                    }
                ]
            }
        ]
    }
}
