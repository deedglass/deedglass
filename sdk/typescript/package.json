{
  "name": "@deedglass/sdk",
  "version": "0.12.0",
  "description": "Put Deedglass in front of your agent's tools: policy decides, people approve, every call is sealed as a deed you can check offline.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=22.12" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./verify": { "types": "./dist/verify/index.d.ts", "default": "./dist/verify/index.js" },
    "./ai-sdk": { "types": "./dist/adapters/ai-sdk.d.ts", "default": "./dist/adapters/ai-sdk.js" },
    "./openai-agents": { "types": "./dist/adapters/openai-agents.d.ts", "default": "./dist/adapters/openai-agents.js" },
    "./langchain": { "types": "./dist/adapters/langchain.d.ts", "default": "./dist/adapters/langchain.js" },
    "./claude-agent-sdk": { "types": "./dist/adapters/claude-agent-sdk.d.ts", "default": "./dist/adapters/claude-agent-sdk.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE", "CHANGELOG.md"],
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json && tsc -p tsconfig.types.json",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run --project unit",
    "test:it": "vitest run --project integration",
    "lint:pkg": "publint --strict && attw --pack . --profile node16 --ignore-rules cjs-resolves-to-esm",
    "size": "node scripts/size.mjs",
    "deps": "node scripts/deps-check.mjs",
    "sync-verify": "node scripts/sync-verify.mjs"
  },
  "dependencies": {},
  "peerDependencies": {
    "ai": ">=7 <8",
    "@openai/agents": ">=0.18 <1",
    "@langchain/core": ">=1.2 <2",
    "@anthropic-ai/claude-agent-sdk": ">=0.3 <0.4"
  },
  "peerDependenciesMeta": {
    "ai": { "optional": true },
    "@openai/agents": { "optional": true },
    "@langchain/core": { "optional": true },
    "@anthropic-ai/claude-agent-sdk": { "optional": true }
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.309",
    "@arethetypeswrong/cli": "0.18.5",
    "@langchain/core": "1.3.0",
    "@openai/agents": "0.21.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "ai": "7.0.150",
    "publint": "0.3.25",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "publishConfig": { "access": "public", "provenance": true },
  "repository": { "type": "git", "url": "git+https://github.com/deedglass/deedglass.git", "directory": "sdk/typescript" },
  "homepage": "https://docs.deedglass.com/sdk/typescript",
  "keywords": ["deedglass", "ai-agents", "mcp", "policy", "approvals", "audit"]
}
