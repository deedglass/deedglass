---
// [icon] Proven · Matches (brand §12, plain names): caption size, weight 600, +0.04em, small caps;
// icon and word always. The API's short names (L2 · VERIFIED) are in the title.
import Icon from './Icon.astro';
interface Props { verdict: 'VERIFIED' | 'MISMATCH' | 'UNVERIFIABLE'; level?: 'L0' | 'L1' | 'L2' }
const { verdict, level } = Astro.props;
const look = { VERIFIED: ['verified', 'check', 'Matches'], MISMATCH: ['mismatch', 'x', 'Doesn’t match'], UNVERIFIABLE: ['unverifiable', 'circle-dashed', 'Can’t check'] } as const;
const [kind, icon, word] = look[verdict];
const names = { L0: 'Claimed', L1: 'Checked', L2: 'Proven' } as const;
---
<span class={`dg-chip dg-chip--${kind}`} title={level ? `${names[level]} · ${word} (${level} · ${verdict})` : `${word} (${verdict})`} translate="no"><Icon name={icon} />{level && <span>{names[level]} ·</span>}<span>{word}</span></span>
