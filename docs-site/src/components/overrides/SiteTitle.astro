---
// The header lockup: the flat Split Orb + the lowercase wordmark (brand §5) + "docs". The paths are
// the final kit's deedglass-flat.svg (DL-018, ~/txv/site/brand/deedglass/final), checked in S36;
// the frost and pane follow the theme. favicon.svg and favicon.ico in public/ are the kit's files.
const { siteTitleHref } = Astro.locals.starlightRoute;
---
<a href={siteTitleHref} class="site-title" aria-label="Deedglass docs, home">
  <svg width="22" height="22" viewBox="0 0 120 120" aria-hidden="true" focusable="false">
    <defs><linearGradient id="dg-title-aurora" gradientUnits="userSpaceOnUse" x1="31.4" y1="8" x2="65.2" y2="112"><stop offset="0" stop-color="#7C6CFF" /><stop offset=".5" stop-color="#4F8CFF" /><stop offset="1" stop-color="#2FE6D1" /></linearGradient></defs>
    <path d="M55.2 8.22A52 52 0 0 0 55.2 111.78Z" fill="url(#dg-title-aurora)" />
    <path d="M64.8 8.22A52 52 0 0 1 64.8 111.78Z" class="frost" />
    <rect x="58.4" y="8.22" width="3.2" height="103.56" class="pane" />
  </svg>
  <span class="word" translate="no">deedglass</span><span class="docs">docs</span>
</a>
<style>
  .site-title { display: inline-flex; align-items: center; gap: 0.5rem; text-decoration: none; color: var(--sl-color-white); min-width: 0; border-radius: 6px; }
  .word { font-size: 1.0625rem; font-weight: 600; letter-spacing: -0.04em; }
  .docs { font-size: 0.875rem; font-weight: 450; color: var(--dg-text-2); padding-inline-start: 0.5rem; border-inline-start: 1px solid var(--dg-hairline); }
  .frost { fill: var(--dg-frost); fill-opacity: 0.85; }
  .pane { fill: var(--dg-pane); }
</style>
