---
// The home hero (S33 §5): ink-950, the Split Orb with the page's one aurora glow and the Sealed
// moment, H1 "See what your agents actually did.", one sentence, action buttons.
import SealedMark from '../SealedMark.astro';
const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
---
<div class="dg-hero">
  <div class="orb-wrap">
    <SealedMark size={124} state="sealed" glow animate class="orb" />
  </div>
  <div class="hero-badge" aria-hidden="true">
    <span class="badge-dot"></span>
    <span class="badge-text">Execution Guardrails & WAL Verification</span>
  </div>
  <h1 id="_top" data-page-title>{title}</h1>
  {tagline && <p class="tagline">{tagline}</p>}
  <div class="actions">
    {actions.map((a: { link: string; text: string; variant?: string }) => (
      <a class:list={['btn', a.variant === 'primary' ? 'primary' : 'secondary']} href={a.link}>{a.text}</a>
    ))}
  </div>
</div>
<style>
  .dg-hero { display: grid; justify-items: center; text-align: center; gap: 1.125rem; padding: 3rem 0 2.5rem; }
  .orb-wrap { display: grid; place-items: center; margin-bottom: 0.25rem; }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    background: var(--dg-surface);
    border: 1px solid var(--dg-hairline);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--dg-text-2);
    letter-spacing: 0.02em;
  }
  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--verified-text-dark);
  }
  h1 {
    font-size: clamp(2.25rem, 3.2vw + 1.25rem, 3.75rem);
    line-height: 1.08;
    letter-spacing: -0.04em;
    font-weight: 650;
    margin: 0;
    max-width: 18ch;
    text-wrap: balance;
    color: var(--sl-color-white);
  }
  .tagline {
    margin: 0;
    max-width: 42rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--dg-text-2);
    text-wrap: pretty;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    padding: 0 1.25rem;
    border-radius: 10px;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 140ms var(--dg-ease-enter), border-color 140ms var(--dg-ease-enter), transform 140ms var(--dg-ease-enter);
  }
  .primary {
    background: var(--sl-color-accent);
    color: var(--sl-color-text-invert);
    border: 1px solid transparent;
  }
  .primary:hover {
    background: var(--sl-color-accent-high);
    transform: translateY(-1px);
  }
  .secondary {
    color: var(--sl-color-white);
    border: 1px solid var(--dg-hairline);
    background: var(--dg-surface);
  }
  .secondary:hover {
    border-color: var(--dg-text-3);
    background: var(--dg-surface-raised);
    transform: translateY(-1px);
  }
</style>
