---
// The home hero (S33 §5): ink-950, the Split Orb with the page's one aurora glow and the Sealed
// moment, H1 "See what your agents actually did.", one sentence, two buttons.
import SealedMark from '../SealedMark.astro';
const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
---
<div class="dg-hero">
  <SealedMark size={132} state="sealed" glow animate class="orb" />
  <h1 id="_top" data-page-title>{title}</h1>
  {tagline && <p class="tagline">{tagline}</p>}
  <div class="actions">
    {actions.map((a: { link: string; text: string; variant?: string }) => (
      <a class:list={['btn', a.variant === 'primary' ? 'primary' : 'secondary']} href={a.link}>{a.text}</a>
    ))}
  </div>
</div>
<style>
  .dg-hero { display: grid; justify-items: center; text-align: center; gap: 1.25rem; padding: 3.5rem 0 3rem; }
  .orb { margin-bottom: 0.75rem; }
  h1 { font-size: clamp(2.25rem, 3vw + 1.25rem, 3.5rem); line-height: 1.06; letter-spacing: -0.045em; font-weight: 650; margin: 0; max-width: 16ch; text-wrap: balance; color: var(--sl-color-white); }
  .tagline { margin: 0; max-width: 38rem; font-size: 1.125rem; line-height: 1.6; color: var(--dg-text-2); text-wrap: pretty; }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; margin-top: 0.5rem; }
  .btn { display: inline-flex; align-items: center; min-height: 44px; padding: 0 20px; border-radius: 10px; font-size: 1rem; font-weight: 550; text-decoration: none; transition: background-color 120ms var(--dg-ease-enter), border-color 120ms var(--dg-ease-enter); }
  .primary { background: var(--sl-color-accent); color: var(--sl-color-text-invert); }
  .primary:hover { background: var(--sl-color-accent-high); }
  .secondary { color: var(--sl-color-white); border: 1px solid var(--dg-hairline); background: var(--dg-surface); }
  .secondary:hover { border-color: var(--dg-text-3); }
</style>
