{
  "name": "@deedglass/docs",
  "version": "0.1.0",
  "private": true,
  "description": "docs.deedglass.com: Astro + Starlight, built to static files.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "gen": "node scripts/gen-data.mjs",
    "gen:check": "node scripts/gen-data.mjs --check",
    "dev": "node scripts/sync-docs.mjs && ASTRO_TELEMETRY_DISABLED=1 astro dev --port 4321",
    "build": "node scripts/sync-docs.mjs && ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/postbuild.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --port 4321",
    "check": "node scripts/check-all.mjs",
    "snippets": "node scripts/test-snippets.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "test": "node --test scripts/test/gates.test.mjs",
    "sync": "node scripts/sync-docs.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.5",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "astro": "7.3.5",
    "starlight-links-validator": "0.26.0",
    "starlight-llms-txt": "0.12.0",
    "starlight-openapi": "0.26.3"
  },
  "devDependencies": {
    "cspell": "10.3.6"
  }
}
