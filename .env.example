# Local development settings for Deedglass. There are no real secrets in this file.
#
# make dev (scripts/dev.sh) copies it to .env with mode 0600 and fills every empty value with fresh
# random ones: passwords from `openssl rand -hex 24`, keys from `openssl rand -base64 32`. .env is
# git-ignored and never enters the Docker image. docs/DEV_LOOP.md explains each line.
#
# Two readers use .env:
#   - docker compose (--env-file .env) fills the ${…} values in deploy/docker-compose.yml.
#   - deedglass itself, in dev only, when you run it from the repo root (make run). Prod ignores .env.

# dev or prod. The local stack is always dev.
DEEDGLASS_ENV=dev

# Runtime role (deedglass_app) for `make run`: from your machine to the compose Postgres on 127.0.0.1:55432.
# scripts/dev.sh replaces the password placeholder with DEEDGLASS_DEV_PG_APP_PASSWORD below.
DEEDGLASS_DATABASE_URL=postgres://deedglass_app:__DEEDGLASS_DEV_PG_APP_PASSWORD__@127.0.0.1:55432/deedglass?sslmode=disable

# Migrator role (deedglass_migrator), used by `deedglass migrate` and `make run` (serve --migrate).
# scripts/dev.sh replaces the password placeholder with DEEDGLASS_DEV_PG_MIGRATOR_PASSWORD below.
DEEDGLASS_MIGRATE_DATABASE_URL=postgres://deedglass_migrator:__DEEDGLASS_DEV_PG_MIGRATOR_PASSWORD__@127.0.0.1:55432/deedglass?sslmode=disable

# Base64 of exactly 32 bytes. Encrypts connector credentials. Filled by scripts/dev.sh.
DEEDGLASS_VAULT_KEY=

# Base64 of at least 32 bytes, mixed into API key hashes. Changing it invalidates every API key. Filled by scripts/dev.sh.
DEEDGLASS_API_KEY_PEPPER=

# debug, info, warn or error. Used by make run and by both containers.
DEEDGLASS_LOG_LEVEL=info

# Optional, make run only: serve Prometheus metrics at http://127.0.0.1:9464/metrics. Off when unset.
# DEEDGLASS_METRICS_LISTEN=127.0.0.1:9464

# Tooling names (the binary ignores DEEDGLASS_DEV_*). Local Postgres passwords, applied when the volume
# is first created; changing them later needs make dev-reset. Filled by scripts/dev.sh.
DEEDGLASS_DEV_PG_ADMIN_PASSWORD=
DEEDGLASS_DEV_PG_MIGRATOR_PASSWORD=
DEEDGLASS_DEV_PG_APP_PASSWORD=
