  "outcomes": {"VERIFIED": "A VERIFIED statement is issued (positive controls and pipeline properties).", "BLOCKED": "Rejected before commit, so no effect.", "DETECTED": "Committed, and a MISMATCH statement or alert was issued.", "UNVERIFIABLE": "An UNVERIFIABLE statement is issued, naming the evidence gap; never MISMATCH and never VERIFIED. V7: the change committed, and the witness sealed UNVERIFIABLE naming the gap.", "OUTSIDE SCOPE": "Behaviour is documented; a VERIFIED or absent statement is expected and asserted.", "NO EFFECT": "Nothing committed, so no statement is expected and none may be issued.", "DENIED": "The Gate refused the action before execution. A deed with decision deny is sealed; the target is unchanged.", "REJECTED": "Refused at authentication or validation with a canonical error code. No action runs; the target is unchanged.", "REDACTED": "The action ran or failed, and no credential value appears in any response, log line, event, deed or Console view.", "MISMATCH": "The change committed; the witness sealed a MISMATCH verdict with a diff."},
  "priorities": {"P0": "Must pass at release gates G3/G4.", "P1": "Must pass by G5 or appear in LIMITATIONS.md as not yet tested.", "doc-only": "Documented; not an automated test in V0."},
