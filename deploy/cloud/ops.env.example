# /etc/deedglass/ops.env: settings for the host scripts only (backup, health, keys mirror). The
# containers never read this file. root:root, mode 0600.
# The age public key (age1…) backups are encrypted to. The private identity stays offline with you.
BACKUP_AGE_RECIPIENT=age1CHANGE_ME
# Better Stack heartbeat URLs (Heartbeats › the heartbeat › copy URL). Pinged only on success.
BACKUP_HEARTBEAT_URL=https://uptime.betterstack.com/api/v1/heartbeat/CHANGE_ME
HEALTH_HEARTBEAT_URL=https://uptime.betterstack.com/api/v1/heartbeat/CHANGE_ME
# rclone's R2 remote, scoped to one bucket (R2 › Manage API tokens › Object Read & Write, one bucket).
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ACCESS_KEY_ID=CHANGE_ME
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=CHANGE_ME
RCLONE_CONFIG_R2_ENDPOINT=https://CHANGE_ME.r2.cloudflarestorage.com
BACKUP_BUCKET=deedglass-backups
# The two copies of keys.json the keys mirror compares (SEAL_KEYS.md step 4).
KEYS_API_URL=https://api.deedglass.com/.well-known/deedglass/keys.json
KEYS_SITE_URL=https://deedglass.com/.well-known/deedglass/keys.json
