# /etc/deedglass/deedglass.env: the server's settings for the cloud beta (S35). root:root, mode 0600;
# compose passes it to the deedglass container with env_file and nothing else reads it.
# Generate each secret on the VM with the command in its comment; never paste one into chat, a
# ticket or git. preflight.sh refuses this file if it is readable by anyone but root.
DEEDGLASS_ENV=prod
DEEDGLASS_BASE_URL=https://app.deedglass.com
# The runtime role over the Unix socket (no TCP to Postgres). PG_APP_PASSWORD from postgres.env.
DEEDGLASS_DATABASE_URL=postgres://deedglass_app:CHANGE_ME_APP@/deedglass?host=/run/postgresql
DEEDGLASS_MIGRATE_DATABASE_URL=postgres://deedglass_migrator:CHANGE_ME_MIGRATOR@/deedglass?host=/run/postgresql
# The exact seal key file (no symlinks), mounted read-only from /etc/deedglass/seal (SEAL_KEYS.md).
DEEDGLASS_SEAL_KEY_FILE=/run/deedglass/seal/sk_CHANGE_ME.json
# openssl rand -base64 32
DEEDGLASS_VAULT_KEY=CHANGE_ME
# openssl rand -base64 32 (keep it stable: a new pepper invalidates every API key)
DEEDGLASS_API_KEY_PEPPER=CHANGE_ME
DEEDGLASS_SIGNUP=invite
# From Resend (Domains › mail.deedglass.com); the sender must be on that domain.
DEEDGLASS_RESEND_API_KEY=CHANGE_ME
DEEDGLASS_MAIL_FROM=Deedglass <no-reply@mail.deedglass.com>
DEEDGLASS_TRUSTED_PROXIES=172.30.0.0/24
DEEDGLASS_METRICS_LISTEN=0.0.0.0:9464
DEEDGLASS_SLOT_LAG_ALERT_MB=1024
DEEDGLASS_LOG_LEVEL=info
# DEEDGLASS_ALLOW_PRIVATE_NETWORKS must not appear here (preflight.sh fails if it does).
