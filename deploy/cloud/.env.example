# /opt/deedglass/deploy/cloud/.env: what compose substitutes into compose.yaml (no secrets here).
# The image by version AND digest, from the release page (UPGRADING.md); upgrade.sh rewrites it.
DEEDGLASS_IMAGE=ghcr.io/deedglass/deedglass:0.1.0@sha256:CHANGE_ME
# Staging until the first health check passes (GO_LIVE.md step 8), then:
#   ACME_CA=https://acme-v02.api.letsencrypt.org/directory
ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
CADDY_EMAIL=hello@deedglass.com
APP_HOST=app.deedglass.com
API_HOST=api.deedglass.com
