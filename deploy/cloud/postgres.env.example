# /etc/deedglass/postgres.env: passwords the first start of Postgres uses to create its roles (S35).
# root:root, mode 0600. Generate each with: openssl rand -base64 32 | tr -d '/+=' | head -c 40
# The same app and migrator passwords go into the two URLs in deedglass.env.
PG_MIGRATOR_PASSWORD=CHANGE_ME
PG_APP_PASSWORD=CHANGE_ME
PG_BACKUP_PASSWORD=CHANGE_ME
