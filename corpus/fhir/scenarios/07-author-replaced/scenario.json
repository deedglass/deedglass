{
  "title": "The author the agent set is replaced by its client",
  "story": "The agent drafts an Observation for a clinician and sets meta.author to that Practitioner. The server records its own author, the agent's client application, and answers 201. The agent reports the Observation as authored by the clinician.",
  "servers": [
    "medplum"
  ],
  "behaviour": "Medplum keeps meta.author as a server-managed element: it records the client that wrote the resource, and names a user the client acts for in meta.onBehalfOf (the X-Medplum-On-Behalf-Of header).",
  "sources": [
    {
      "says": "The calling app is recorded in meta.author; the user it acts for in meta.onBehalfOf.",
      "url": "https://www.medplum.com/docs/auth/on-behalf-of"
    }
  ],
  "setup": {
    "seed": [
      {
        "label": "patient",
        "method": "POST",
        "path": "Patient",
        "body": {
          "resourceType": "Patient",
          "identifier": [
            {
              "system": "urn:example:fhir-bench:mrn",
              "value": "${nonce}-p1"
            }
          ],
          "name": [
            {
              "family": "Synthetic",
              "given": [
                "Asha"
              ]
            }
          ],
          "birthDate": "1980-01-01"
        }
      }
    ]
  },
  "steps": [
    {
      "session": "agent",
      "method": "POST",
      "path": "Observation",
      "body": {
        "resourceType": "Observation",
        "status": "preliminary",
        "identifier": [
          {
            "system": "urn:example:fhir-bench:obs",
            "value": "${nonce}-hr-7"
          }
        ],
        "category": [
          {
            "coding": [
              {
                "system": "http://terminology.hl7.org/CodeSystem/observation-category",
                "code": "vital-signs"
              }
            ]
          }
        ],
        "code": {
          "coding": [
            {
              "system": "http://loinc.org",
              "code": "8867-4",
              "display": "Heart rate"
            }
          ]
        },
        "subject": {
          "reference": "Patient/${id:patient}"
        },
        "effectiveDateTime": "2026-10-21T09:30:00Z",
        "valueQuantity": {
          "value": 72,
          "unit": "beats/minute",
          "system": "http://unitsofmeasure.org",
          "code": "/min"
        },
        "meta": {
          "author": {
            "reference": "Practitioner/${nonce}-dr-a"
          }
        }
      },
      "note": "create with meta.author set by the agent"
    }
  ],
  "agent_reports": {
    "summary": "Charted the heart rate with the clinician as its author.",
    "effect": {
      "changes": {
        "Observation": {
          "create": 1
        }
      }
    }
  }
}
