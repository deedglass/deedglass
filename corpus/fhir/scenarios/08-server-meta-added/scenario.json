{
  "title": "The server adds meta, and nothing else changes",
  "story": "A plain create. The server adds meta.versionId, meta.lastUpdated, its author and project, and answers 201; everything the agent sent is stored as sent. The agent's report is right: a tool that flags the server's own meta raises a false alarm.",
  "servers": [
    "medplum"
  ],
  "behaviour": "FHIR R4: the server maintains meta.versionId and meta.lastUpdated on every write; Medplum also records meta.author and meta.project.",
  "sources": [
    {
      "says": "Create: the server assigns the id and version and returns them in Location and ETag.",
      "url": "https://hl7.org/fhir/R4/http.html#create"
    }
  ],
  "setup": {
    "seed": [
      {
        "label": "patient",
        "method": "POST",
        "path": "Patient",
        "body": {
          "resourceType": "Patient",
          "identifier": [
            {
              "system": "urn:example:fhir-bench:mrn",
              "value": "${nonce}-p1"
            }
          ],
          "name": [
            {
              "family": "Synthetic",
              "given": [
                "Asha"
              ]
            }
          ],
          "birthDate": "1980-01-01"
        }
      }
    ]
  },
  "steps": [
    {
      "session": "agent",
      "method": "POST",
      "path": "Observation",
      "body": {
        "resourceType": "Observation",
        "status": "preliminary",
        "identifier": [
          {
            "system": "urn:example:fhir-bench:obs",
            "value": "${nonce}-hr-8"
          }
        ],
        "category": [
          {
            "coding": [
              {
                "system": "http://terminology.hl7.org/CodeSystem/observation-category",
                "code": "vital-signs"
              }
            ]
          }
        ],
        "code": {
          "coding": [
            {
              "system": "http://loinc.org",
              "code": "8867-4",
              "display": "Heart rate"
            }
          ]
        },
        "subject": {
          "reference": "Patient/${id:patient}"
        },
        "effectiveDateTime": "2026-10-21T09:30:00Z",
        "valueQuantity": {
          "value": 72,
          "unit": "beats/minute",
          "system": "http://unitsofmeasure.org",
          "code": "/min"
        }
      },
      "note": "plain create"
    }
  ],
  "agent_reports": {
    "summary": "Charted the heart rate as a new Observation.",
    "effect": {
      "changes": {
        "Observation": {
          "create": 1
        }
      }
    }
  }
}
