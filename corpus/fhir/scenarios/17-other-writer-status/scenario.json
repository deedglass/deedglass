{
  "title": "Another system changes the order's status after the agent",
  "story": "The agent puts a MedicationRequest on hold with a full update; the server stores exactly that. Then the pharmacy system sets the status back to active through its own client. The agent's report of its own write is right: a tool that blames the agent for the later change raises a false alarm.",
  "servers": [
    "medplum"
  ],
  "behaviour": "FHIR R4 update: each update stores a new version; a later writer's version is that writer's, not the agent's.",
  "sources": [
    {
      "says": "Update creates a new current version for an existing resource.",
      "url": "https://hl7.org/fhir/R4/http.html#update"
    }
  ],
  "setup": {
    "seed": [
      {
        "label": "patient",
        "method": "POST",
        "path": "Patient",
        "body": {
          "resourceType": "Patient",
          "identifier": [
            {
              "system": "urn:example:fhir-bench:mrn",
              "value": "${nonce}-p1"
            }
          ],
          "name": [
            {
              "family": "Synthetic",
              "given": [
                "Asha"
              ]
            }
          ],
          "birthDate": "1980-01-01"
        }
      },
      {
        "label": "rx",
        "method": "POST",
        "path": "MedicationRequest",
        "body": {
          "resourceType": "MedicationRequest",
          "status": "active",
          "intent": "order",
          "identifier": [
            {
              "system": "urn:example:fhir-bench:rx",
              "value": "${nonce}-rx-17"
            }
          ],
          "medicationCodeableConcept": {
            "text": "Synthetic medication A"
          },
          "subject": {
            "reference": "Patient/${id:patient}"
          },
          "authoredOn": "2026-10-20"
        }
      }
    ]
  },
  "steps": [
    {
      "session": "agent",
      "method": "PUT",
      "path": "MedicationRequest/${id:rx}",
      "body": {
        "resourceType": "MedicationRequest",
        "status": "on-hold",
        "intent": "order",
        "identifier": [
          {
            "system": "urn:example:fhir-bench:rx",
            "value": "${nonce}-rx-17"
          }
        ],
        "medicationCodeableConcept": {
          "text": "Synthetic medication A"
        },
        "subject": {
          "reference": "Patient/${id:patient}"
        },
        "authoredOn": "2026-10-20",
        "id": "${id:rx}"
      },
      "note": "the agent puts the order on hold"
    },
    {
      "session": "other",
      "method": "PATCH",
      "path": "MedicationRequest/${id:rx}",
      "body": [
        {
          "op": "replace",
          "path": "/status",
          "value": "active"
        }
      ],
      "note": "the pharmacy system sets it back to active"
    }
  ],
  "agent_reports": {
    "summary": "Put the medication order on hold.",
    "effect": {
      "changes": {
        "MedicationRequest": {
          "update": 1
        }
      }
    }
  }
}
