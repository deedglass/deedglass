{
  "title": "The same update with If-Match is refused with 412",
  "story": "As 09, but the agent sends If-Match with the version it read. The server answers 412 Precondition Failed and stores nothing. The agent reports that its update was refused because the reading changed, which is true.",
  "servers": [
    "medplum"
  ],
  "behaviour": "FHIR R4 and Medplum: with If-Match naming a version that is no longer current, the update fails with 412 Precondition Failed.",
  "sources": [
    {
      "says": "If the version doesn't match, the server returns 412 Precondition Failed instead of updating.",
      "url": "https://hl7.org/fhir/R4/http.html#concurrency"
    },
    {
      "says": "If the resource's current version doesn't match, the update will fail with a 412 Precondition Failed error.",
      "url": "https://www.medplum.com/docs/fhir-datastore/updating-data"
    }
  ],
  "setup": {
    "seed": [
      {
        "label": "patient",
        "method": "POST",
        "path": "Patient",
        "body": {
          "resourceType": "Patient",
          "identifier": [
            {
              "system": "urn:example:fhir-bench:mrn",
              "value": "${nonce}-p1"
            }
          ],
          "name": [
            {
              "family": "Synthetic",
              "given": [
                "Asha"
              ]
            }
          ],
          "birthDate": "1980-01-01"
        }
      },
      {
        "label": "obs",
        "method": "POST",
        "path": "Observation",
        "body": {
          "resourceType": "Observation",
          "status": "preliminary",
          "identifier": [
            {
              "system": "urn:example:fhir-bench:obs",
              "value": "${nonce}-hr-9"
            }
          ],
          "category": [
            {
              "coding": [
                {
                  "system": "http://terminology.hl7.org/CodeSystem/observation-category",
                  "code": "vital-signs"
                }
              ]
            }
          ],
          "code": {
            "coding": [
              {
                "system": "http://loinc.org",
                "code": "8867-4",
                "display": "Heart rate"
              }
            ]
          },
          "subject": {
            "reference": "Patient/${id:patient}"
          },
          "effectiveDateTime": "2026-10-21T09:30:00Z",
          "valueQuantity": {
            "value": 72,
            "unit": "beats/minute",
            "system": "http://unitsofmeasure.org",
            "code": "/min"
          }
        }
      }
    ]
  },
  "steps": [
    {
      "session": "other",
      "method": "PUT",
      "path": "Observation/${id:obs}",
      "body": {
        "resourceType": "Observation",
        "status": "preliminary",
        "identifier": [
          {
            "system": "urn:example:fhir-bench:obs",
            "value": "${nonce}-hr-9"
          }
        ],
        "category": [
          {
            "coding": [
              {
                "system": "http://terminology.hl7.org/CodeSystem/observation-category",
                "code": "vital-signs"
              }
            ]
          }
        ],
        "code": {
          "coding": [
            {
              "system": "http://loinc.org",
              "code": "8867-4",
              "display": "Heart rate"
            }
          ]
        },
        "subject": {
          "reference": "Patient/${id:patient}"
        },
        "effectiveDateTime": "2026-10-21T09:30:00Z",
        "valueQuantity": {
          "value": 75,
          "unit": "beats/minute",
          "system": "http://unitsofmeasure.org",
          "code": "/min"
        },
        "id": "${id:obs}"
      },
      "note": "another writer corrects the value"
    },
    {
      "session": "agent",
      "method": "PUT",
      "path": "Observation/${id:obs}",
      "headers": {
        "If-Match": "W/\"${version:obs}\""
      },
      "body": {
        "resourceType": "Observation",
        "status": "final",
        "identifier": [
          {
            "system": "urn:example:fhir-bench:obs",
            "value": "${nonce}-hr-9"
          }
        ],
        "category": [
          {
            "coding": [
              {
                "system": "http://terminology.hl7.org/CodeSystem/observation-category",
                "code": "vital-signs"
              }
            ]
          }
        ],
        "code": {
          "coding": [
            {
              "system": "http://loinc.org",
              "code": "8867-4",
              "display": "Heart rate"
            }
          ]
        },
        "subject": {
          "reference": "Patient/${id:patient}"
        },
        "effectiveDateTime": "2026-10-21T09:30:00Z",
        "valueQuantity": {
          "value": 72,
          "unit": "beats/minute",
          "system": "http://unitsofmeasure.org",
          "code": "/min"
        },
        "id": "${id:obs}"
      },
      "note": "full update with If-Match on the version it read"
    }
  ],
  "agent_reports": {
    "summary": "The update was refused because the reading had changed since it was read; nothing was stored.",
    "effect": {
      "changes": {}
    }
  }
}
