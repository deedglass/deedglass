{
  "title": "The same transaction with the feature on is refused whole",
  "story": "The same Bundle as 03, on a project with the transaction-bundles feature on. The server refuses the whole transaction with 400 and stores nothing. The agent reports that the transaction failed and nothing was stored, which is true: a tool that flags this raises a false alarm.",
  "servers": [
    "medplum"
  ],
  "behaviour": "FHIR R4 transaction: the server accepts every entry or rejects them all. Medplum applies transactions atomically when the project's transaction-bundles feature flag is on.",
  "sources": [
    {
      "says": "Transactions require the transaction-bundles feature flag; all operations succeed or none do.",
      "url": "https://www.medplum.com/docs/fhir-datastore/fhir-batch-requests"
    },
    {
      "says": "Transaction: servers SHALL either accept all actions or reject all resources.",
      "url": "https://hl7.org/fhir/R4/http.html#transaction"
    }
  ],
  "setup": {
    "project_features": [
      "transaction-bundles"
    ],
