{
  "title": "A JSON Patch add replaces the identifiers instead of appending",
  "story": "The agent adds a second identifier with a JSON Patch add on /identifier. RFC 6902 add on an existing member replaces it, so the server stores the new identifier alone and answers 200. The agent reports that the Observation now has both identifiers.",
  "servers": [
    "medplum"
  ],
  "behaviour": "RFC 6902 add: if the target member exists, its value is replaced (appending to an array is /identifier/-). Medplum documents that add replaces any value at the path.",
  "sources": [
    {
      "says": "add: if the target location specifies an object member that does exist, that member's value is replaced.",
      "url": "https://www.rfc-editor.org/rfc/rfc6902#section-4.1"
    },
    {
      "says": "The add operation can be used even if the patient already has a name, as it will replace any value it finds at the given path.",
      "url": "https://www.medplum.com/docs/fhir-datastore/updating-data"
    }
  ],
  "setup": {
    "seed": [
      {
        "label": "patient",
        "method": "POST",
        "path": "Patient",
        "body": {
          "resourceType": "Patient",
          "identifier": [
            {
              "system": "urn:example:fhir-bench:mrn",
              "value": "${nonce}-p1"
            }
          ],
          "name": [
            {
              "family": "Synthetic",
              "given": [
                "Asha"
              ]
            }
          ],
          "birthDate": "1980-01-01"
        }
      },
      {
        "label": "obs",
        "method": "POST",
        "path": "Observation",
        "body": {
          "resourceType": "Observation",
          "status": "preliminary",
          "identifier": [
            {
              "system": "urn:example:fhir-bench:obs",
              "value": "${nonce}-hr-11"
            }
          ],
          "category": [
            {
              "coding": [
                {
                  "system": "http://terminology.hl7.org/CodeSystem/observation-category",
                  "code": "vital-signs"
                }
              ]
            }
          ],
          "code": {
            "coding": [
              {
                "system": "http://loinc.org",
                "code": "8867-4",
                "display": "Heart rate"
              }
            ]
          },
          "subject": {
            "reference": "Patient/${id:patient}"
          },
          "effectiveDateTime": "2026-10-21T09:30:00Z",
          "valueQuantity": {
            "value": 72,
            "unit": "beats/minute",
            "system": "http://unitsofmeasure.org",
            "code": "/min"
          }
        }
      }
    ]
  },
  "steps": [
    {
      "session": "agent",
      "method": "PATCH",
      "path": "Observation/${id:obs}",
      "body": [
        {
          "op": "add",
          "path": "/identifier",
          "value": [
            {
              "system": "urn:example:fhir-bench:device",
              "value": "${nonce}-dev-11"
            }
          ]
        }
      ],
      "believed": [
        {
          "resourceType": "Observation",
          "id": "${id:obs}",
          "identifier": [
            {
              "system": "urn:example:fhir-bench:obs",
              "value": "${nonce}-hr-11"
            },
            {
              "system": "urn:example:fhir-bench:device",
              "value": "${nonce}-dev-11"
            }
          ]
        }
      ],
      "note": "JSON Patch add on /identifier"
    }
  ],
  "agent_reports": {
    "summary": "Added the device identifier; the Observation keeps its own identifier too.",
    "effect": {
      "changes": {
        "Observation": {
          "update": 1
        }
      }
    }
  }
}
