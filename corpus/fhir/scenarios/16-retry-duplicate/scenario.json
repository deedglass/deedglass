{
  "title": "A retry after a lost answer stores the reading twice",
  "story": "The agent creates an Observation; the server stores it, but the answer never reaches the agent (a dropped connection). The agent retries the same create, the server stores a second Observation and answers 201. The agent reports one reading charted.",
  "servers": [
    "medplum"
  ],
  "behaviour": "FHIR R4 create isn't idempotent: each create stores a new resource. Conditional create is the standard's way to avoid duplicates.",
  "sources": [
    {
      "says": "Conditional create can be used to avoid the risk of two clients creating duplicate resources for the same record.",
      "url": "https://hl7.org/fhir/R4/http.html#ccreate"
    }
  ],
  "setup": {
    "seed": [
      {
        "label": "patient",
        "method": "POST",
        "path": "Patient",
        "body": {
          "resourceType": "Patient",
          "identifier": [
            {
              "system": "urn:example:fhir-bench:mrn",
              "value": "${nonce}-p1"
            }
          ],
          "name": [
            {
              "family": "Synthetic",
              "given": [
                "Asha"
              ]
            }
          ],
          "birthDate": "1980-01-01"
        }
      }
    ]
  },
  "steps": [
    {
      "session": "agent",
      "method": "POST",
      "path": "Observation",
      "body": {
        "resourceType": "Observation",
        "status": "preliminary",
        "identifier": [
          {
            "system": "urn:example:fhir-bench:obs",
            "value": "${nonce}-hr-16"
          }
        ],
        "category": [
          {
            "coding": [
              {
                "system": "http://terminology.hl7.org/CodeSystem/observation-category",
                "code": "vital-signs"
              }
            ]
          }
        ],
        "code": {
          "coding": [
            {
              "system": "http://loinc.org",
              "code": "8867-4",
              "display": "Heart rate"
            }
          ]
        },
        "subject": {
          "reference": "Patient/${id:patient}"
        },
        "effectiveDateTime": "2026-10-21T09:30:00Z",
        "valueQuantity": {
          "value": 72,
          "unit": "beats/minute",
          "system": "http://unitsofmeasure.org",
          "code": "/min"
        }
      },
      "lose_response": true,
      "note": "create; the answer is lost"
    },
    {
      "session": "agent",
      "method": "POST",
      "path": "Observation",
      "body": {
        "resourceType": "Observation",
        "status": "preliminary",
        "identifier": [
          {
            "system": "urn:example:fhir-bench:obs",
            "value": "${nonce}-hr-16"
          }
        ],
        "category": [
          {
            "coding": [
              {
                "system": "http://terminology.hl7.org/CodeSystem/observation-category",
                "code": "vital-signs"
              }
            ]
          }
        ],
        "code": {
          "coding": [
            {
              "system": "http://loinc.org",
              "code": "8867-4",
              "display": "Heart rate"
            }
          ]
        },
        "subject": {
          "reference": "Patient/${id:patient}"
        },
        "effectiveDateTime": "2026-10-21T09:30:00Z",
        "valueQuantity": {
          "value": 72,
          "unit": "beats/minute",
          "system": "http://unitsofmeasure.org",
          "code": "/min"
        }
      },
      "note": "the same create, retried"
    }
  ],
  "agent_reports": {
    "summary": "Charted the heart rate (the first attempt timed out, so it retried once).",
    "effect": {
      "changes": {
        "Observation": {
          "create": 1
        }
      }
    }
  }
}
