{
  "resourceType": "StructureDefinition",
  "id": "aaph-provenance",
  "url": "https://deedglass.com/fhir/aap-h/StructureDefinition/aaph-provenance",
  "name": "AaphProvenance",
  "title": "AAP-H AI agent action Provenance",
  "version": "0.1.0-draft",
  "status": "draft",
  "experimental": true,
  "date": "2026-10-26",
  "publisher": "Deedglass contributors",
  "jurisdiction": [
    {
      "coding": [
        {
          "system": "http://unstats.un.org/unsd/methods/m49/m49.htm",
          "code": "001",
          "display": "World"
        }
      ]
    }
  ],
  "copyright": "Apache-2.0. Part of Agent Action Provenance for Health (AAP-H) v0.1 draft.",
  "description": "The provenance of a resource an AI agent created, updated or deleted: the agent, the policy decision, the approval chain, the claimed and verified outcomes, and the signed record.",
  "fhirVersion": "4.0.1",
  "kind": "resource",
  "abstract": false,
  "type": "Provenance",
  "baseDefinition": "http://hl7.org/fhir/StructureDefinition/Provenance",
  "derivation": "constraint",
  "differential": {
    "element": [
      {
        "id": "Provenance",
        "path": "Provenance",
        "short": "AI agent action Provenance",
        "definition": "The provenance of a resource an AI agent created, updated or deleted: the agent, the policy decision, the approval chain, the claimed and verified outcomes, and the signed record.",
        "constraint": [
          {
            "key": "aaph-1",
            "severity": "error",
            "human": "A decision of require-approval has at least one approval step.",
            "expression": "extension('https://deedglass.com/fhir/aap-h/StructureDefinition/aaph-policy-decision').extension('decision').value = 'require-approval' implies extension('https://deedglass.com/fhir/aap-h/StructureDefinition/aaph-approval').exists()",
            "source": "https://deedglass.com/fhir/aap-h/StructureDefinition/aaph-provenance"
          },
          {
            "key": "aaph-2",
            "severity": "error",
            "human": "A write is never recorded as a match at depth reported.",
            "expression": "extension('https://deedglass.com/fhir/aap-h/StructureDefinition/aaph-action').extension('interaction').value in ('create' | 'update' | 'patch' | 'delete' | 'operation' | 'execute') implies extension('https://deedglass.com/fhir/aap-h/StructureDefinition/aaph-verified-outcome').where(extension('result').value = 'match' and extension('depth').value = 'reported').empty()",
            "source": "https://deedglass.com/fhir/aap-h/StructureDefinition/aaph-provenance"
          },
          {
            "key": "aaph-3",
            "severity": "warning",
            "human": "A write the tool reported as succeeded has a verified outcome.",
            "expression": "(extension('https://deedglass.com/fhir/aap-h/StructureDefinition/aaph-action').extension('interaction').value in ('create' | 'update' | 'patch' | 'delete' | 'operation' | 'execute') and extension('https://deedglass.com/fhir/aap-h/StructureDefinition/aaph-claimed-outcome').extension('status').value = 'succeeded') implies extension('https://deedglass.com/fhir/aap-h/StructureDefinition/aaph-verified-outcome').exists()",
            "source": "https://deedglass.com/fhir/aap-h/StructureDefinition/aaph-provenance"
          },
          {
            "key": "aaph-4",
            "severity": "error",
            "human": "Exactly one agent is the AI agent, and it is a Device.",
            "expression": "agent.where(role.coding.where(system = 'https://deedglass.com/fhir/aap-h/CodeSystem/aaph-participant' and code = 'ai-agent').exists()).count() = 1",
            "source": "https://deedglass.com/fhir/aap-h/StructureDefinition/aaph-provenance"
          }
        ]
      },
      {
        "id": "Provenance.extension",
        "path": "Provenance.extension",
        "slicing": {
          "discriminator": [
            {
              "type": "value",
              "path": "url"
            }
          ],
          "rules": "open"
        },
        "min": 2
      },
      {
        "id": "Provenance.extension:action",
        "path": "Provenance.extension",
        "sliceName": "action",
        "min": 1,
        "max": "1",
        "type": [
          {
            "code": "Extension",
            "profile": [
              "https://deedglass.com/fhir/aap-h/StructureDefinition/aaph-action"
            ]
          }
        ]
      },
      {
        "id": "Provenance.extension:policyDecision",
        "path": "Provenance.extension",
        "sliceName": "policyDecision",
        "min": 1,
        "max": "1",
        "type": [
          {
            "code": "Extension",
