      {
        "id": "Provenance.agent:approver",
        "path": "Provenance.agent",
        "sliceName": "approver",
        "min": 0,
        "max": "*"
      },
      {
        "id": "Provenance.agent:approver.type",
        "path": "Provenance.agent.type",
