              "https://deedglass.com/fhir/aap-h/StructureDefinition/aaph-verified-outcome"
            ]
          }
        ]
      },
      {
        "id": "Provenance.extension:recordSeal",
        "path": "Provenance.extension",
        "sliceName": "recordSeal",
        "min": 0,
        "max": "1",
        "type": [
          {
            "code": "Extension",
            "profile": [
              "https://deedglass.com/fhir/aap-h/StructureDefinition/aaph-record-seal"
            ]
          }
        ]
      },
      {
        "id": "Provenance.agent",
        "path": "Provenance.agent",
        "slicing": {
          "discriminator": [
            {
              "type": "pattern",
              "path": "role"
            }
          ],
          "rules": "open"
