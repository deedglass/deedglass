        "max": "*",
        "type": [
          {
            "code": "Extension",
            "profile": [
              "https://deedglass.com/fhir/aap-h/StructureDefinition/aaph-authorization"
            ]
          }
        ]
      },
      {
        "id": "Provenance.extension:claimedOutcome",
        "path": "Provenance.extension",
        "sliceName": "claimedOutcome",
        "min": 0,
        "max": "1",
        "type": [
          {
            "code": "Extension",
