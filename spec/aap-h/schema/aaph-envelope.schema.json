{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deedglass.com/spec/aap-h/schema/aaph-envelope.schema.json",
  "title": "AAP-H envelope v0.1",
  "description": "One AI agent action on a health system, as JSON (Agent Action Provenance for Health, v0.1 draft, section 6). Apache-2.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "aaph",
    "record_id",
    "issuer",
    "recorded_at",
    "agent",
    "action",
    "authorization",
    "policy",
    "approvals",
    "claimed",
    "verified",
    "supersedes",
    "chain",
    "seal",
    "extensions"
  ],
  "properties": {
    "aaph": {
      "const": "0.1"
    },
    "record_id": {
      "$ref": "#/$defs/id"
    },
    "issuer": {
      "$ref": "#/$defs/httpsUri"
    },
    "recorded_at": {
      "$ref": "#/$defs/time"
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "name",
        "model",
        "on_behalf_of",
        "session"
      ],
      "properties": {
        "kind": {
          "const": "ai-agent"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/text64"
        },
        "model": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "provider",
                "name",
                "version"
              ],
              "properties": {
                "provider": {
                  "$ref": "#/$defs/text64"
                },
                "name": {
                  "$ref": "#/$defs/text64"
                },
                "version": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "$ref": "#/$defs/text64"
                    }
                  ]
                }
              }
            }
          ]
        },
        "on_behalf_of": {
          "$ref": "#/$defs/refOrNull"
        },
        "session": {
          "$ref": "#/$defs/refOrNull"
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tool",
        "interaction",
        "agent_role",
        "system",
        "target",
        "request_digest",
        "intent_digest"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "tool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\u0000-\u001f\u007f]+$"
        },
        "interaction": {
          "enum": [
            "create",
            "read",
            "update",
            "patch",
            "delete",
            "search",
            "operation",
            "execute",
            "other"
          ]
        },
        "agent_role": {
          "enum": [
            "proposed",
            "made"
          ]
        },
        "system": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "base"
          ],
          "properties": {
            "kind": {
              "enum": [
                "fhir",
                "postgres",
                "saas",
                "other"
              ]
            },
            "base": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "pattern": "^[a-z][a-z0-9+.-]*:[^\\s]+$"
                }
              ]
            }
          }
        },
        "target": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref",
              "version"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[^\\s]+$"
              },
              "version": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[^\\s]+$"
                  }
                ]
              }
            }
          }
        },
        "request_digest": {
          "$ref": "#/$defs/digest"
        },
        "intent_digest": {
          "$ref": "#/$defs/digestOrNull"
        }
      }
    },
    "authorization": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "ref",
          "scope",
          "digest"
        ],
        "properties": {
          "kind": {
            "enum": [
              "smart-scope",
              "consent",
              "grant",
              "other"
            ]
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\s]+$"
          },
          "scope": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^[\\x21-\\x7e]+( [\\x21-\\x7e]+)*$"
              }
            ]
          },
          "digest": {
            "$ref": "#/$defs/digestOrNull"
          }
        }
      }
    },
    "policy": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decision",
            "mode",
            "policy",
            "version_digest",
            "rule"
          ],
          "properties": {
            "decision": {
              "enum": [
                "allow",
                "deny",
                "require-approval"
              ]
            },
            "mode": {
              "enum": [
                "enforce",
                "shadow"
              ]
            },
            "policy": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/id"
                }
              ]
            },
            "version_digest": {
              "$ref": "#/$defs/digestOrNull"
            },
            "rule": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
                }
              ]
            }
          }
        }
      ]
    },
    "approvals": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step",
          "outcome",
          "approvers",
          "role",
          "decided_at"
        ],
        "properties": {
          "step": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
          },
          "outcome": {
            "enum": [
              "approved",
              "denied",
              "expired",
              "cancelled"
            ]
          },
          "approvers": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/ref"
            }
          },
          "role": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/text64"
              }
            ]
          },
          "decided_at": {
            "$ref": "#/$defs/timeOrNull"
          }
        }
      }
    },
    "claimed": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "assertion",
            "result_digest",
            "error_code",
            "started_at",
            "finished_at"
          ],
          "properties": {
            "status": {
              "enum": [
                "succeeded",
                "failed",
                "unknown"
              ]
            },
            "assertion": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                }
              ]
            },
            "result_digest": {
              "$ref": "#/$defs/digestOrNull"
            },
            "error_code": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
                }
              ]
            },
            "started_at": {
              "$ref": "#/$defs/timeOrNull"
            },
            "finished_at": {
              "$ref": "#/$defs/timeOrNull"
            }
          }
        }
      ]
    },
    "verified": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result",
            "depth",
            "method",
            "detail_digest",
            "checked_at"
          ],
          "properties": {
            "result": {
              "enum": [
                "match",
                "mismatch",
                "cannot-check"
              ]
            },
            "depth": {
              "enum": [
                "reported",
                "read-back",
                "change-log"
              ]
            },
            "method": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
            },
            "detail_digest": {
              "$ref": "#/$defs/digestOrNull"
            },
            "checked_at": {
              "$ref": "#/$defs/timeOrNull"
            }
          }
        }
      ]
    },
    "supersedes": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/id"
        }
      ]
    },
    "chain": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stream",
            "seq",
            "prev"
          ],
          "properties": {
            "stream": {
              "$ref": "#/$defs/id"
            },
            "seq": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "prev": {
              "$ref": "#/$defs/digest"
            }
          }
        }
      ]
    },
    "seal": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "alg",
            "key_id",
            "key_set",
            "record_digest",
            "signature"
          ],
          "properties": {
            "format": {
              "const": "aaph-jcs"
            },
            "alg": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,31}$"
            },
            "key_id": {
              "$ref": "#/$defs/id"
            },
            "key_set": {
              "$ref": "#/$defs/httpsUri"
            },
            "record_digest": {
              "$ref": "#/$defs/digest"
            },
            "signature": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,31}:[A-Za-z0-9_-]+$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "record_digest",
            "native"
          ],
          "properties": {
            "format": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$",
              "not": {
                "const": "aaph-jcs"
              }
            },
            "record_digest": {
              "$ref": "#/$defs/digest"
            },
            "native": {
              "type": "object"
            }
          }
        }
      ]
    },
    "extensions": {
      "type": "object"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._~:@/+=-]{1,256}$"
    },
    "refOrNull": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/ref"
        }
      ]
    },
    "text64": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[^\u0000-\u001f\u007f-\u009f]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "digestOrNull": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/digest"
        }
      ]
    },
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "timeOrNull": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/time"
        }
      ]
    },
    "httpsUri": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^https://[^\\s/]+(/[^\\s]*)?$"
    }
  }
}
